{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This project deploys as a Cloudflare Worker with static assets (the
  // current unified replacement for what used to be "Cloudflare Pages").
  // `npm run build` produces the static site in dist/; Cloudflare serves
  // those files directly for any request that matches one, and only
  // invokes worker/index.ts for everything else (in practice, just
  // /api/videos and /api/settings — the admin panel's write endpoints).
  "name": "dannydwyer",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown addresses get the site's own "Page Not Found" page
    // (src/pages/404.astro) with a 404 status, instead of an empty page.
    "not_found_handling": "404-page",
    // Without this, Cloudflare serves static files (including /admin's own
    // HTML) directly and the Worker never runs for them — which means the
    // login gate below could never intercept a request for the admin page
    // itself. This routes every request through the Worker first; it falls
    // back to env.ASSETS.fetch() for anything that isn't /admin* or /api/*.
    "run_worker_first": true
  }
}
