---
// The Work page (/work) and its category pages (/documentary, /commercial,
// /music-videos): one template, so they can never drift apart. A category
// page is the same gallery pre-filtered to its tag, with its own title and
// description; its button shows as active.
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import WorkBanner from './sections/WorkBanner.astro';
import WorkControls from './sections/WorkControls.astro';
import WorkGrid from './sections/WorkGrid.astro';
import { getCollection, getEntry } from 'astro:content';
import { getThumbnails, byDisplayOrder, byCategoryOrder } from '../lib/video';
import { getEnabledSections } from '../data/layout';
import { getSeoOverride } from '../data/seo';
import { CATEGORIES, type Category } from '../data/categories';

interface Props {
  category?: Category;
}
const { category } = Astro.props;

const sections = getEnabledSections('work');
const seo = getSeoOverride('work');
const page = await getEntry('pages', 'work');
const { Content } = await page.render();
const videos = (await getCollection('videos', (v) => !v.data.hidden)).sort((a, b) => byDisplayOrder(a.data, b.data));
// Each category page has its own order; the gallery's cards are put in the
// right one for whichever single category is being shown (see the script).
const categoryOrders = Object.fromEntries(
  CATEGORIES.map((c) => [
    c.tag,
    videos
      .filter((v) => v.data.tags.some((t) => t.toLowerCase() === c.tag))
      .sort((a, b) => byCategoryOrder(c.tag)(a.data, b.data))
      .map((v) => v.data.urlSlug),
  ])
);
const workRank = new Map(videos.map((v, i) => [v.data.urlSlug, i]));
if (category) {
  const rank = new Map(categoryOrders[category.tag].map((slug, i) => [slug, i]));
  videos.sort((a, b) => (rank.get(a.data.urlSlug) ?? Infinity) - (rank.get(b.data.urlSlug) ?? Infinity) || byDisplayOrder(a.data, b.data));
}

const thumbnails = await Promise.all(videos.map((v) => getThumbnails(v.data)));

const allTags = [...new Set(videos.flatMap((v) => v.data.tags))].sort();

const inCategory = category ? videos.filter((v) => v.data.tags.some((t) => t.toLowerCase() === category.tag)) : videos;
const description = category
  ? `${category.label}: ${inCategory.length} ${category.noun} by filmmaker, director, and cinematographer Danny Dwyer, including ${inCategory
      .slice(0, 3)
      .map((v) => v.data.title)
      .join(', ')}.`
  : seo.description ||
    `Selected narrative, commercial, and documentary cinematography — ${videos.length} projects, searchable by tag, role, and format.`;

// ItemList structured data — gives search engines and AI answer engines a
// clean, complete manifest of every piece of work on this page.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: inCategory.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/work/${v.data.urlSlug}`, Astro.site).toString(),
      name: v.data.title,
    })),
  },
];
---

<Layout
  title="Work"
  titleOverride={category ? category.title : seo.title || undefined}
  description={description}
  ogImage={seo.ogImage || undefined}
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main
    class="main container"
    data-category={category?.tag}
    data-categories={JSON.stringify(CATEGORIES.map((c) => ({ slug: c.slug, tag: c.tag })))}
    data-category-orders={JSON.stringify(categoryOrders)}
  >
    {sections.map((section) => {
      if (section === 'banner') {
        return (
          <WorkBanner title={page.data.title}>
            <Content />
          </WorkBanner>
        );
      }
      if (section === 'controls') return <WorkControls allTags={allTags} activeTag={category?.tag} />;
      if (section === 'grid') return (
          <WorkGrid
            videos={videos}
            thumbnails={thumbnails}
            initialTag={category?.tag}
            workRanks={videos.map((v) => workRank.get(v.data.urlSlug)!)}
          />
        );
      return null;
    })}
  </main>
  <SiteFooter />
</Layout>

<script>
  // This script coordinates two separate sections (Filters + search live in
  // WorkControls, the cards live in WorkGrid), so either one can be turned
  // off in src/data/layout.json without breaking the other: no controls ->
  // every video just shows, unfiltered; no grid -> the controls still render
  // but there's nothing for them to filter.
  const searchInput = document.getElementById('search') as HTMLInputElement | null;
  const videoList = document.getElementById('video-list');
  const rows = Array.from(document.querySelectorAll('#video-list .card')) as HTMLElement[];
  // The Work page order (from each card's data-work-rank: a category page
  // renders its cards in its own order) and each category's own order, as
  // lists of slugs.
  const pageMain = document.querySelector('main') as HTMLElement;
  const categoryOrders: Record<string, string[]> = JSON.parse(pageMain.dataset.categoryOrders ?? '{}');
  const workOrder = [...rows]
    .sort((a, b) => Number(a.dataset.workRank) - Number(b.dataset.workRank))
    .map((row) => row.dataset.slug!);

  // Shows the cards in a category's own order when exactly that category
  // is selected, and in the Work page order otherwise.
  function arrangeRows(selected: Set<string>) {
    if (!videoList) return;
    const only = selected.size === 1 ? [...selected][0] : null;
    const catOrder = only ? categoryOrders[only] : undefined;
    const order = catOrder ? [...catOrder, ...workOrder.filter((slug) => !catOrder.includes(slug))] : workOrder;
    const bySlug = new Map(rows.map((row) => [row.dataset.slug!, row]));
    order.forEach((slug) => {
      const row = bySlug.get(slug);
      if (row) videoList.appendChild(row);
    });
  }
  const emptyState = document.getElementById('empty-state') as HTMLElement | null;

  const toggleBtn = document.getElementById('filters-toggle') as HTMLButtonElement | null;
  const badge = document.getElementById('filters-badge') as HTMLElement | null;
  const selectedChips = document.getElementById('selected-chips') as HTMLElement | null;
  const panel = document.getElementById('filters-panel') as HTMLElement | null;
  const tagToggles = Array.from(panel?.querySelectorAll('.tag-toggle') ?? []) as HTMLButtonElement[];
  const clearBtn = document.getElementById('filters-clear') as HTMLButtonElement | null;
  const applyBtn = document.getElementById('filters-apply') as HTMLButtonElement | null;

  function applyFilters(selected: Set<string>) {
    if (!searchInput) return;
    arrangeRows(selected);
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    rows.forEach((row) => {
      const rowTags = row.dataset.tags?.split('|') ?? [];
      const matchesTags = selected.size === 0 || [...selected].some((tag) => rowTags.includes(tag));
      const matchesQuery = !query || (row.dataset.search ?? '').includes(query);
      const show = matchesTags && matchesQuery;
      row.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;
  }

  // The controls section (search/filters) only exists if WorkControls is
  // enabled — everything below this guard wires it up.
  if (searchInput && toggleBtn && badge && selectedChips && panel && clearBtn && applyBtn) {
    // The applied (committed) set of selected tags — what actually drives
    // filtering and the chip row. Checkbox state inside the panel is only
    // "pending" until Apply commits it (or Clear All zeroes everything).
    let selected = new Set<string>();

    const main = document.querySelector('main') as HTMLElement;
    const categories: { slug: string; tag: string }[] = JSON.parse(main.dataset.categories ?? '[]');
    const presetBtns = Array.from(document.querySelectorAll('.preset-btn')) as HTMLElement[];

    // A category page starts filtered to its tag; /work starts from any
    // ?tag= params in the address (old shared links keep working).
    const initialTags = new URLSearchParams(location.search).getAll('tag');
    if (initialTags.length) initialTags.forEach((tag) => selected.add(tag.toLowerCase()));
    else if (main.dataset.category) selected.add(main.dataset.category);

    // Keep the address bar in sync with the active filters so the current
    // view can always be copied and shared (or reloaded) as-is: exactly one
    // category's tag -> its own page (/music-videos), anything else ->
    // /work with one ?tag= per selected tag. Also lights up the matching
    // category button.
    function syncUrl() {
      const only = selected.size === 1 ? [...selected][0] : null;
      const cat = categories.find((c) => c.tag === only);
      const params = new URLSearchParams(location.search);
      params.delete('tag');
      if (!cat) selected.forEach((tag) => params.append('tag', tag));
      const qs = params.toString();
      history.replaceState(null, '', (cat ? `/${cat.slug}` : '/work') + (qs ? `?${qs}` : ''));
      presetBtns.forEach((btn) => {
        const active = !!cat && btn.dataset.tag === cat.tag;
        btn.classList.toggle('is-active', active);
        if (active) btn.setAttribute('aria-current', 'page');
        else btn.removeAttribute('aria-current');
      });
    }

    function syncTogglesToSelected() {
      tagToggles.forEach((btn) => {
        const active = selected.has(btn.dataset.tag!);
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    }

    function renderChips() {
      selectedChips!.innerHTML = '';
      selected.forEach((tag) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'selected-chip';
        chip.dataset.tag = tag;
        // Built with textContent, not innerHTML: tags can come straight from
        // the ?tag= URL param, so they must never be parsed as HTML.
        const x = document.createElement('span');
        x.setAttribute('aria-hidden', 'true');
        x.textContent = '×';
        chip.textContent = `${tag} `;
        chip.appendChild(x);
        chip.setAttribute('aria-label', `Remove ${tag} filter`);
        selectedChips!.appendChild(chip);
      });
      badge!.hidden = selected.size === 0;
      badge!.textContent = String(selected.size);
    }

    function openPanel() {
      syncTogglesToSelected();
      panel!.hidden = false;
      toggleBtn!.setAttribute('aria-expanded', 'true');
    }

    function closePanel() {
      panel!.hidden = true;
      toggleBtn!.setAttribute('aria-expanded', 'false');
    }

    toggleBtn.addEventListener('click', () => {
      if (panel!.hidden) openPanel();
      else closePanel();
    });

    tagToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nowActive = btn.getAttribute('aria-pressed') !== 'true';
        btn.classList.toggle('active', nowActive);
        btn.setAttribute('aria-pressed', String(nowActive));
      });
    });

    applyBtn.addEventListener('click', () => {
      selected = new Set(
        tagToggles.filter((btn) => btn.getAttribute('aria-pressed') === 'true').map((btn) => btn.dataset.tag!)
      );
      renderChips();
      applyFilters(selected);
      syncUrl();
      closePanel();
    });

    clearBtn.addEventListener('click', () => {
      tagToggles.forEach((btn) => {
        btn.classList.remove('active');
        btn.setAttribute('aria-pressed', 'false');
      });
      selected = new Set();
      renderChips();
      applyFilters(selected);
      syncUrl();
      closePanel();
    });

    selectedChips.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest('.selected-chip') as HTMLElement | null;
      if (!chip?.dataset.tag) return;
      selected.delete(chip.dataset.tag);
      renderChips();
      applyFilters(selected);
      syncUrl();
    });

    document.addEventListener('click', (e) => {
      if (panel!.hidden) return;
      const target = e.target as Node;
      if (!panel!.contains(target) && !toggleBtn!.contains(target)) closePanel();
    });

    renderChips();
    applyFilters(selected);
    syncUrl();
    searchInput.addEventListener('input', () => applyFilters(selected));
  }
</script>

<style>
  .main {
    padding-top: 1rem;
    padding-bottom: 3rem;
  }
</style>
