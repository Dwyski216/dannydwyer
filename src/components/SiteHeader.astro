---
import { site } from '../data/site';

interface Props {
  hideLogo?: boolean;
}
const { hideLogo = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header container">
  {hideLogo ? (
    <span aria-hidden="true"></span>
  ) : (
    <a class="wordmark" href="/">
      <img class="bolt" src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_01_PRIMARY.png" alt="" width="100" height="100" />
      <span class="name">{site.name}</span>
    </a>
  )}
  <nav class="nav">
    <a href="/" class:list={{ active: isActive('/') && path === '/' }}>Home</a>
    <a href="/work" class:list={{ active: isActive('/work') }}>Work</a>
    <a href="/contact" class:list={{ active: isActive('/contact') }}>Contact</a>
  </nav>
</header>

<style>
  .header {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .bolt {
    height: 100px;
    width: 100px;
    display: block;
  }

  @media (max-width: 600px) {
    .wordmark {
      gap: 0.6rem;
    }

    .bolt {
      height: 48px;
      width: 48px;
    }
  }

  /* The Signature Treatment: Barn Red letters with a hard-edge Headlight
     drop shadow on Ink, offset down-and-right at roughly 37° — no blur.
     Sized in em so the shadow's offset stays proportional to the text at
     any size, mobile included. */
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 2.875rem;
    color: var(--barn-red);
    text-shadow: 0.075em 0.056em 0 var(--headlight);
  }

  @media (max-width: 600px) {
    .name {
      font-size: 1.45rem;
    }
  }

  .nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav a {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
