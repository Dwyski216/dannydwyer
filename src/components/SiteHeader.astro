---
import { site } from '../data/site';
import { CATEGORIES } from '../data/categories';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header container">
  <a class="name" href="/">
    <img src="/images/DANNY_DWYER_BOLT_BANNER.webp" alt={site.name} width="2000" height="367" />
  </a>
  <nav class="nav">
    <a href="/" class:list={{ active: isActive('/') && path === '/' }}>Home</a>
    <a href="/work" class:list={{ active: isActive('/work') || CATEGORIES.some((c) => isActive(`/${c.slug}`)) }}>Work</a>
    <a href="/contact" class:list={{ active: isActive('/contact') }}>Contact</a>
  </nav>
</header>

<style>
  .header {
    position: relative;
    padding-top: 2rem;
    padding-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* The name as artwork: Headlight DANNY DWYER split by the Barn Red bolt
     (DANNY_DWYER_BOLT_BANNER), centered at the top with the nav centered
     below it, on every screen. */
  .name {
    display: block;
    line-height: 0;
  }

  .name img {
    display: block;
    /* --banner-width (Layout.astro): 472px on desktop and tablets,
       min(360px, 88vw) on phones. Page titles are sized from it. */
    width: var(--banner-width);
    height: auto;
    /* The bolt sits a hair left of the artwork's middle (its center is at
       990.5 of 2000px), so nudge the image right by that 0.475% to put the
       bolt on the page's center line. */
    transform: translateX(0.475%);
  }

  /* Three columns with the middle one centered: WORK sits exactly on the
     center line under the bolt, HOME and CONTACT balanced either side
     (a plain centered row would center the group, pulling WORK left
     because CONTACT is longer than HOME). */
  .nav {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    column-gap: 1.75rem;
    /* WORK centers on the middle of the gap between the Y and the D (1021
       of the artwork's 2000px), 1.525% of the banner's width right of the
       page center, less 2px by eye; padding on one side moves the center
       by half of it. */
    padding-left: calc(var(--banner-width) * 0.0305 - 4px);
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav a:first-child {
    justify-self: end;
  }

  .nav a:last-child {
    justify-self: start;
  }

  .nav a {
    /* Matches the letter-spacing after the last letter, so the word (and
       its underline) is centered in its box. */
    padding-left: 0.08em;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav a:hover {
    color: var(--olympic-gold);
  }

  /* Current page: Headlight, semi-bold. Trade Gothic has no semi-bold
     cut, so a hairline stroke in the text colour thickens the regular
     (same trick as the footer email). */
  .nav a.active {
    color: var(--headlight);
    border-bottom-color: var(--headlight);
    -webkit-text-stroke: 0.035em currentColor;
  }

  .nav a.active:hover {
    color: var(--olympic-gold);
    border-bottom-color: var(--olympic-gold);
  }
</style>
