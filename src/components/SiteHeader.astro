---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header container">
  <a class="name" href="/">
    <img src="/images/DANNY_DWYER_BOLT_BANNER.webp" alt={site.name} width="2000" height="367" />
  </a>
  <nav class="nav">
    <a href="/" class:list={{ active: isActive('/') && path === '/' }}>Home</a>
    <a href="/work" class:list={{ active: isActive('/work') }}>Work</a>
    <a href="/contact" class:list={{ active: isActive('/contact') }}>Contact</a>
  </nav>
</header>

<style>
  .header {
    position: relative;
    padding-top: 2rem;
    padding-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* The name as artwork: Headlight DANNY DWYER split by the Barn Red bolt
     (DANNY_DWYER_BOLT_BANNER). On desktop the banner sits at the far left,
     opposite the nav; on phones the banner and the nav below it are both
     centered. */
  .name {
    display: block;
    line-height: 0;
  }

  .name img {
    display: block;
    /* 472px on desktop; on tablets it scales down just enough to keep the
       nav on the same row. */
    width: clamp(240px, 100vw - 340px, 472px);
    height: auto;
  }

  @media (min-width: 601px) {
    .name {
      margin-right: auto;
    }
  }

  @media (max-width: 600px) {
    .header {
      justify-content: center;
    }

    .name img {
      width: min(240px, 60vw);
    }

    .nav {
      width: 100%;
      justify-content: center;
    }
  }

  .nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav a {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav a:hover {
    color: var(--olympic-gold);
  }

  /* Current page: Headlight, semi-bold. Trade Gothic has no semi-bold
     cut, so a hairline stroke in the text colour thickens the regular
     (same trick as the footer email). */
  .nav a.active {
    color: var(--headlight);
    border-bottom-color: var(--headlight);
    -webkit-text-stroke: 0.035em currentColor;
  }

  .nav a.active:hover {
    color: var(--olympic-gold);
    border-bottom-color: var(--olympic-gold);
  }
</style>
