---
import { site } from '../data/site';

interface Props {
  hideLogo?: boolean;
}
const { hideLogo = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header container">
  {hideLogo ? (
    <span aria-hidden="true"></span>
  ) : (
    <>
      <a class="logo-mark" href="/" aria-label={site.name}>
        <img class="bolt" src="/DWYER_MONOGRAM_VARIATIONS/FLAT/DD_FLAT_HEADLIGHT_RED.png" alt="" width="100" height="100" />
      </a>
      <a class="name" href="/">
        <img src="/images/DWYSKI_BANNER.webp" alt={site.name} width="2000" height="199" />
      </a>
    </>
  )}
  <nav class="nav">
    <a href="/" class:list={{ active: isActive('/') && path === '/' }}>Home</a>
    <a href="/work" class:list={{ active: isActive('/work') }}>Work</a>
    <a href="/contact" class:list={{ active: isActive('/contact') }}>Contact</a>
  </nav>
</header>

<style>
  .header {
    position: relative;
    padding-top: 2rem;
    padding-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .logo-mark {
    display: block;
    line-height: 0;
    flex-shrink: 0;
  }

  .bolt {
    height: 100px;
    width: 100px;
    display: block;
  }

  @media (max-width: 600px) {
    .bolt {
      height: 48px;
      width: 48px;
    }
  }

  /* The Signature Treatment wordmark (Barn Red letters with a hard-edge
     Headlight drop shadow), supplied as artwork in DWYSKI_BANNER rather
     than set in type. Centered across the full header on desktop
     (independent of the logo mark, which stays pinned top-left); on
     narrow screens there isn't room to center it without overlapping the
     logo or nav, so it drops back into the normal flex flow next to them. */
  .name {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    line-height: 0;
  }

  .name img {
    display: block;
    width: 400px;
    height: auto;
  }

  @media (max-width: 600px) {
    .name {
      position: static;
      transform: none;
    }

    .name img {
      width: 200px;
    }
  }

  .nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav a {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
