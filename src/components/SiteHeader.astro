---
import { site } from '../data/site';

interface Props {
  hideLogo?: boolean;
}
const { hideLogo = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header container">
  {hideLogo ? (
    <span aria-hidden="true"></span>
  ) : (
    <>
      <a class="logo-mark" href="/" aria-label={site.name}>
        <img class="bolt" src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_07_ONE_COLOR_DARK.png" alt="" width="100" height="100" />
      </a>
      <a class="name" href="/">
        <img src="/images/DANNY_DWYER_BOLT_BANNER.webp" alt={site.name} width="2000" height="367" />
      </a>
    </>
  )}
  <nav class="nav">
    <a href="/" class:list={{ active: isActive('/') && path === '/' }}>Home</a>
    <a href="/work" class:list={{ active: isActive('/work') }}>Work</a>
    <a href="/contact" class:list={{ active: isActive('/contact') }}>Contact</a>
  </nav>
</header>

<style>
  .header {
    position: relative;
    padding-top: 2rem;
    padding-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .logo-mark {
    display: block;
    line-height: 0;
    flex-shrink: 0;
  }

  .bolt {
    height: 100px;
    width: 100px;
    display: block;
  }

  @media (max-width: 600px) {
    .bolt {
      height: 48px;
      width: 48px;
    }
  }

  /* The name as artwork: Headlight DANNY DWYER split by the Barn Red bolt
     (DANNY_DWYER_BOLT_BANNER). On desktop the D/D mark is dropped and the
     banner sits at the far left, opposite the nav, with its letters the
     same height the typeset name had; on phones the mark stays and the
     banner sits beside it, sized to fill the space without crowding. */
  .name {
    display: block;
    line-height: 0;
  }

  .name img {
    display: block;
    /* 472px on desktop; on tablets it scales down just enough to keep the
       nav on the same row. */
    width: clamp(240px, 100vw - 340px, 472px);
    height: auto;
  }

  @media (min-width: 601px) {
    .logo-mark {
      display: none;
    }

    .name {
      margin-right: auto;
    }
  }

  @media (max-width: 600px) {
    .name img {
      width: min(240px, 60vw);
    }
  }

  .nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav a {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav a:hover {
    color: var(--olympic-gold);
  }

  /* Current page: Headlight, semi-bold. Trade Gothic has no semi-bold
     cut, so a hairline stroke in the text colour thickens the regular
     (same trick as the footer email). */
  .nav a.active {
    color: var(--headlight);
    border-bottom-color: var(--headlight);
    -webkit-text-stroke: 0.035em currentColor;
  }

  .nav a.active:hover {
    color: var(--olympic-gold);
    border-bottom-color: var(--olympic-gold);
  }
</style>
