---
import { site } from '../data/site';

interface Props {
  hideLogo?: boolean;
}
const { hideLogo = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header container">
  {hideLogo ? (
    <span aria-hidden="true"></span>
  ) : (
    <a class="wordmark" href="/">
      <img class="bolt" src="/images/dd-logo-128.png" alt="" width="40" height="40" />
      <span class="name">{site.name}</span>
    </a>
  )}
  <nav class="nav">
    <a href="/" class:list={{ active: isActive('/') && path === '/' }}>Home</a>
    <a href="/work" class:list={{ active: isActive('/work') }}>Work</a>
    <a href="/contact" class:list={{ active: isActive('/contact') }}>Contact</a>
  </nav>
</header>

<style>
  .header {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .bolt {
    height: 40px;
    width: 40px;
    display: block;
  }

  /* The Signature Treatment: Barn Red letters with a hard-edge Headlight
     drop shadow on Ink, offset down-and-right at roughly 37° — no blur. */
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.15rem;
    color: var(--barn-red);
    text-shadow: 0.075em 0.056em 0 var(--headlight);
  }

  .nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav a {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
