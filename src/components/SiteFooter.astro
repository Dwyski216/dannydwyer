---
import { site } from '../data/site';
import SocialIcons from './SocialIcons.astro';
const year = new Date().getFullYear();

---

<footer class="footer">
  <div class="footer-inner container">
    <div class="links">
      <SocialIcons />
    </div>
    <a class="footer-logo" href="/" aria-label={`${site.name}: home`}>
      <img src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_02_LIGHT.png" alt="" width="72" height="72" loading="lazy" />
    </a>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    <span class="copyright">
      <img class="mark" src="/DWYER_MONOGRAM_VARIATIONS/FLAT/DD_FLAT_HEADLIGHT_MONO.png" alt="" width="18" height="18" />
      &copy; {year} {site.name}
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--shit-kicker);
    margin-top: auto;
  }

  /* Desktop: social icons on the left, the circle monogram dead center
     with the copyright centered under it, and the email on the right.
     The email is sized so its letters run the same height as the icons
     (top of the icons to the bottom of the icons), and nudged so both sit
     on one line. Stacks, all centered, on narrow screens. */
  .footer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas:
      'links logo email'
      '.     copy .';
    align-items: center;
    gap: 0.75rem 1.5rem;
    font-size: 0.85rem;
    color: var(--headlight);
  }

  .links {
    grid-area: links;
    justify-self: start;
  }

  .footer-logo {
    grid-area: logo;
    justify-self: center;
    line-height: 0;
  }

  .footer-logo img {
    display: block;
    width: 72px;
    height: 72px;
  }

  /* Same type as the home page's "Peep The Work" button: Trade Gothic
     Bold No. 2 at 1rem with the same letter spacing. */
  .email {
    grid-area: email;
    justify-self: end;
    font-family: var(--font-title);
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: var(--email-size);
    line-height: 1;
    white-space: nowrap;
    text-decoration: underline;
    text-underline-offset: 0.12em;
    transform: translateY(var(--email-nudge));
    transition: color 0.15s ease;
    --email-size: 1.1rem;
    --email-nudge: -0.6em;
  }

  .email:hover {
    color: var(--olympic-gold);
  }

  .copyright {
    grid-area: copy;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mark {
    display: block;
    opacity: 0.9;
  }

  /* Below ~1000px the row doesn't fit, so stack everything, centered. */
  @media (max-width: 1000px) {
    .footer-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'logo'
        'email'
        'links'
        'copy';
      justify-items: center;
      text-align: center;
      gap: 1.25rem;
    }

    .links,
    .email {
      justify-self: center;
    }

    .links :global(.social-icons) {
      justify-content: center;
    }

    .email {
      transform: none;
    }

    .footer-logo img {
      width: 56px;
      height: 56px;
    }
  }

</style>
