---
import { site } from '../data/site';
import SocialIcons from './SocialIcons.astro';
const year = new Date().getFullYear();

---

<footer class="footer">
  <div class="footer-inner container">
    <div class="links">
      <SocialIcons />
    </div>
    <span class="copyright">
      <img class="mark" src="/DWYER_MONOGRAM_VARIATIONS/FLAT/DD_FLAT_HEADLIGHT_MONO.png" alt="" width="18" height="18" />
      &copy; {year} {site.name}
    </span>
    <div class="contact">
      <a class="footer-logo" href="/" aria-label={`${site.name}: home`}>
        <img src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_02_LIGHT.png" alt="" width="72" height="72" loading="lazy" />
      </a>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--shit-kicker);
    margin-top: auto;
  }

  /* Desktop: social icons on the left and the circle monogram with the
     email (twice the footer text size) on the right, with the small mark
     and copyright centered on its own line underneath. Stacks, all
     centered, on narrow screens. */
  .footer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'links contact'
      'copy copy';
    align-items: center;
    gap: 1.25rem 1.5rem;
    font-size: 0.85rem;
    color: var(--headlight);
  }

  .links {
    grid-area: links;
  }

  .contact {
    grid-area: contact;
  }

  .copyright {
    grid-area: copy;
  }

  .copyright {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: center;
  }

  .mark {
    display: block;
    opacity: 0.9;
  }

  .contact {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .footer-logo {
    flex-shrink: 0;
    line-height: 0;
  }

  .footer-logo img {
    display: block;
    width: 72px;
    height: 72px;
  }

  /* The brand typeface (Futura Bold, per the style guide), kept lowercase
     since it's an address people type. */
  .email {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.7rem;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .email:hover {
    color: var(--olympic-gold);
  }

  .links {
    justify-self: start;
  }

  /* Below ~900px the icons and email don't fit side by side, so stack. */
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'contact'
        'links'
        'copy';
      justify-items: center;
      text-align: center;
    }

    .links {
      justify-self: center;
    }

    .links :global(.social-icons) {
      justify-content: center;
    }

    .contact {
      justify-self: center;
    }

    .footer-logo img {
      width: 56px;
      height: 56px;
    }
  }

  /* Phones: smaller email, scaled to the screen so it always fits on one
     line next to the logo. */
  @media (max-width: 600px) {
    .email {
      font-size: min(1.3rem, 4.6vw);
    }
  }
</style>
