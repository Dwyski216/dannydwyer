---
import { site } from '../data/site';
import SocialIcons from './SocialIcons.astro';
import FooterSparkles from './FooterSparkles.astro';
---

<footer class="footer">
  <FooterSparkles side="left" />
  <FooterSparkles side="right" />
  <div class="footer-inner container">
    <div class="links">
      <SocialIcons />
    </div>
    <a class="footer-logo" href="/" aria-label={`${site.name}: home`}>
      <img src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_02_LIGHT.png" alt="" width="104" height="104" loading="lazy" />
    </a>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</footer>

<style>
  /* Shit Kicker band with Headlight sparkle clusters at both edges.
     Desktop: social icons on the left, the circle monogram dead center, and
     the email in Futura Bold caps on the right, all on one line. Stacks,
     centered, on narrow screens (where the sparkles are dropped, since
     there's no room for them beside the content). */
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--shit-kicker);
    margin-top: auto;
  }

  .footer-inner {
    position: relative;
    min-height: 15rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'links logo email';
    align-items: center;
    gap: 1.5rem;
    color: var(--headlight);
  }

  .links {
    grid-area: links;
    justify-self: start;
  }

  .footer-logo {
    grid-area: logo;
    justify-self: center;
    line-height: 0;
  }

  .footer-logo img {
    display: block;
    width: 104px;
    height: 104px;
  }

  .email {
    grid-area: email;
    justify-self: end;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--headlight);
    transition: color 0.15s ease;
  }

  .email:hover {
    color: var(--olympic-gold);
  }

  /* The sparkle clusters sit in the side margins, so they only show where
     the margins are wide enough to hold them clear of the content. */
  @media (max-width: 1320px) {
    .footer :global(.sparkles) {
      display: none;
    }
  }

  /* Below ~1100px the row doesn't fit, so stack everything, centered. */
  @media (max-width: 1100px) {
    .footer-inner {
      min-height: 0;
      grid-template-columns: 1fr;
      grid-template-areas:
        'logo'
        'email'
        'links';
      justify-items: center;
      text-align: center;
      gap: 1.25rem;
    }

    .links,
    .email {
      justify-self: center;
    }

    .email {
      margin-bottom: 1rem;
    }

    .links :global(.social-icons) {
      justify-content: center;
    }

    .footer-logo img {
      width: 72px;
      height: 72px;
    }
  }

  /* Phones: scale the email with the screen so it stays on one line. */
  @media (max-width: 600px) {
    .email {
      font-size: min(1.25rem, 5.2vw);
    }
  }
</style>
