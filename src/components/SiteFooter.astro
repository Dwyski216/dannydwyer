---
import { site } from '../data/site';
import SocialIcons from './SocialIcons.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="links">
      <SocialIcons />
    </div>
    <a class="footer-logo" href="/" aria-label={`${site.name}: home`}>
      <img src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_02_LIGHT.png" alt="" width="114" height="114" loading="lazy" />
    </a>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    <p class="copyright">&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  /* Shit Kicker band. Desktop: social icons, the circle monogram and the
     email in Futura Bold caps on one line, with equal space between the
     three (the two empty 1fr columns share the free width evenly), and the
     copyright centered under the monogram. Stacks, centered, on narrow
     screens. */
  .footer {
    background: var(--shit-kicker);
    margin-top: auto;
  }

  .footer-inner {
    position: relative;
    min-height: 15rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    grid-template-areas:
      'links . logo . email'
      '.     . copy . .';
    align-items: center;
    align-content: center;
    column-gap: 1.5rem;
    row-gap: 0.75rem;
    color: var(--headlight);
  }

  .links {
    grid-area: links;
    justify-self: start;
  }

  .footer-logo {
    grid-area: logo;
    justify-self: center;
    line-height: 0;
  }

  .footer-logo img {
    display: block;
    width: 114px;
    height: 114px;
  }

  .copyright {
    grid-area: copy;
    justify-self: center;
    margin: 0;
    font-size: 0.85rem;
    color: var(--headlight);
  }

  .email {
    grid-area: email;
    justify-self: end;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--headlight);
    transition: color 0.15s ease;
  }

  .email:hover {
    color: var(--olympic-gold);
  }

  /* Below ~1100px the row doesn't fit, so stack everything, centered. */
  @media (max-width: 1100px) {
    .footer-inner {
      min-height: 0;
      grid-template-columns: 1fr;
      grid-template-areas:
        'logo'
        'email'
        'links'
        'copy';
      justify-items: center;
      text-align: center;
      gap: 1.25rem;
    }

    .links,
    .email {
      justify-self: center;
    }

    .email {
      margin-bottom: 1rem;
    }

    .links :global(.social-icons) {
      justify-content: center;
    }

    .copyright {
      margin-top: 1rem;
    }

    .footer-logo img {
      width: 72px;
      height: 72px;
    }
  }

  /* Phones: scale the email with the screen so it stays on one line. */
  @media (max-width: 600px) {
    .email {
      font-size: min(1.25rem, 5.2vw);
    }
  }
</style>
