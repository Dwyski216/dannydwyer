---
import { site } from '../data/site';
import SocialIcons from './SocialIcons.astro';
const year = new Date().getFullYear();

---

<footer class="footer">
  <div class="footer-inner container">
    <div class="links">
      <SocialIcons />
    </div>
    <span class="copyright">
      <img class="mark" src="/DWYER_MONOGRAM_VARIATIONS/FLAT/DD_FLAT_HEADLIGHT_MONO.png" alt="" width="18" height="18" />
      &copy; {year} {site.name}
    </span>
    <div class="contact">
      <a class="footer-logo" href="/" aria-label={`${site.name}: home`}>
        <img src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_02_LIGHT.png" alt="" width="72" height="72" loading="lazy" />
      </a>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--shit-kicker);
    margin-top: auto;
  }

  /* Three columns on desktop: social icons on the left, the small mark
     and copyright centered, and the circle monogram with the email (at
     twice the footer text size) on the right. Stacks on narrow screens. */
  .footer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--headlight);
  }

  .copyright {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: center;
  }

  .mark {
    display: block;
    opacity: 0.9;
  }

  .contact {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .footer-logo {
    flex-shrink: 0;
    line-height: 0;
  }

  .footer-logo img {
    display: block;
    width: 72px;
    height: 72px;
  }

  .email {
    font-size: 1.7rem;
    text-decoration: underline;
    white-space: nowrap;
  }

  .email:hover {
    color: var(--headlight);
  }

  .links {
    justify-self: start;
  }

  /* Below ~1100px the three columns don't fit side by side, so stack. */
  @media (max-width: 1100px) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .links {
      justify-self: center;
    }

    .links :global(.social-icons) {
      justify-content: center;
    }

    .contact {
      justify-self: center;
      order: -1;
    }

    .footer-logo img {
      width: 56px;
      height: 56px;
    }
  }

  /* Phones: smaller email so it fits on one line. */
  @media (max-width: 600px) {
    .email {
      font-size: 1.3rem;
    }
  }
</style>
