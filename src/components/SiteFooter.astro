---
import { site } from '../data/site';
const year = new Date().getFullYear();
const socialLinks = Object.entries(site.socials).filter(([, url]) => url);

// A few platform names have a correct brand casing that plain CSS
// text-transform: capitalize can't produce.
const displayNames: Record<string, string> = {
  imdb: 'IMDb',
  linkedin: 'LinkedIn',
  youtube: 'YouTube',
};
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="links">
      {socialLinks.map(([name, url]) => (
        <a
          class="social"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${site.name} on ${displayNames[name] ?? name}`}
        >
          {displayNames[name] ?? name}
        </a>
      ))}
    </div>
    <span class="copyright">
      <img class="mark" src="/DWYER_MONOGRAM_VARIATIONS/FLAT/DD_FLAT_HEADLIGHT_MONO.png" alt="" width="18" height="18" />
      &copy; {year} {site.name}
    </span>
    <div class="contact">
      <a class="footer-logo" href="/" aria-label={`${site.name}: home`}>
        <img src="/DWYER_MONOGRAM_VARIATIONS/CIRCLE/DD_CIRCLE_02_LIGHT.png" alt="" width="72" height="72" loading="lazy" />
      </a>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--shit-kicker);
    margin-top: auto;
  }

  /* Three columns on desktop: social links on the left, the small mark
     and copyright centered, and the circle monogram with the email (at
     twice the footer text size) on the right. Stacks on narrow screens. */
  .footer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--headlight);
  }

  .copyright {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: center;
  }

  .mark {
    display: block;
    opacity: 0.9;
  }

  .contact {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .footer-logo {
    flex-shrink: 0;
    line-height: 0;
  }

  .footer-logo img {
    display: block;
    width: 72px;
    height: 72px;
  }

  .email {
    font-size: 1.7rem;
    text-decoration: underline;
    white-space: nowrap;
  }

  .email:hover {
    color: var(--headlight);
  }

  /* Below ~1100px the three columns don't fit side by side, so stack. */
  @media (max-width: 1100px) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .links {
      justify-content: center;
    }

    .contact {
      justify-self: center;
      order: -1;
    }

    .footer-logo img {
      width: 56px;
      height: 56px;
    }

  }

  /* Phones: smaller email so it fits on one line. */
  @media (max-width: 600px) {
    .email {
      font-size: 1.3rem;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    column-gap: 1.5rem;
  }

  .links a {
    text-decoration: underline;
  }

  .links .social {
    text-transform: capitalize;
  }

  .links a:hover {
    color: var(--headlight);
  }
</style>
