---
import { getEmbedUrl } from '../lib/video';

interface Props {
  platform: 'youtube' | 'vimeo';
  videoId: string;
  title: string;
}
const { platform, videoId, title } = Astro.props;

const src = getEmbedUrl({ platform, videoId });

const allow =
  platform === 'vimeo'
    ? 'autoplay; fullscreen; picture-in-picture; clipboard-write'
    : 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
---

<div class="embed-wrap">
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow={allow}
    allowfullscreen
  ></iframe>
</div>

<style>
  .embed-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .embed-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
