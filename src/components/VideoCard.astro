---
interface Props {
  slug: string;
  title: string;
  // The video's Card Line, shown in full under the title. Never the SEO
  // summary: that stays in the project page's meta tags.
  line?: string;
  tags: string[];
  thumbnailUrl: string;
  // Swapped in if thumbnailUrl fails to load (an uploaded thumbnail falls
  // back to the video platform's own).
  fallbackUrl?: string;
  // Rendered hidden (a category page shows only its own videos before the
  // filter script runs, so there's no flash of the full catalog).
  initiallyHidden?: boolean;
  // Its position in the Work page order, for galleries that re-sort cards.
  workRank?: number;
  // The title's heading level: 3 under a section heading (Featured Work,
  // More for ...), 2 on the Work pages, where cards sit right under the
  // page title. Looks the same either way.
  headingLevel?: 2 | 3;
}
const { slug, title, line, tags, thumbnailUrl, fallbackUrl, initiallyHidden = false, workRank, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const searchText = `${title} ${line ?? ''} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="card"
  href={`/work/${slug}/`}
  data-slug={slug}
  data-work-rank={workRank}
  data-tags={tags.join('|').toLowerCase()}
  data-search={searchText}
  style={initiallyHidden ? 'display: none' : undefined}
>
  <div class="thumb">
    <img
      src={thumbnailUrl}
      alt={title}
      loading="lazy"
      width="480"
      height="270"
      data-fallback={fallbackUrl}
      onerror={fallbackUrl ? 'this.onerror=null;this.src=this.dataset.fallback' : undefined}
    />
  </div>
  <div class="meta">
    <Heading class="card-title">{title}</Heading>
    {line && <p class="line">{line}</p>}
  </div>
</a>

<script>
  // Same-size cards: in each gallery, give every visible card's text area
  // the height of the tallest one. Phones (one card per row, a single
  // scroll) skip it: each card ends right after its own Card Line. Redone
  // when the screen size changes, once the fonts load, and when the Work
  // page's filters show other cards.
  function equalizeCards() {
    document.querySelectorAll('.card-gallery').forEach((gallery) => {
      const metas = Array.from(gallery.querySelectorAll<HTMLElement>('.card'))
        .filter((card) => card.offsetParent)
        .map((card) => card.querySelector<HTMLElement>('.meta')!);
      metas.forEach((m) => (m.style.minHeight = ''));
      const oneColumn = new Set(metas.map((m) => Math.round(m.getBoundingClientRect().left))).size <= 1;
      if (oneColumn) return;
      const tallest = Math.max(0, ...metas.map((m) => m.getBoundingClientRect().height));
      metas.forEach((m) => (m.style.minHeight = `${tallest}px`));
    });
  }

  let frame = 0;
  const schedule = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(equalizeCards);
  };
  equalizeCards();
  document.fonts.ready.then(schedule);
  window.addEventListener('resize', schedule);
  window.addEventListener('cards:filtered', schedule);
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: filter 0.2s ease;
  }

  .card:hover .thumb img {
    filter: grayscale(0);
  }

  /* With two or three cards per row, every card in a gallery is made as
     tall as the tallest one there (see the script above); any spare space
     falls at the bottom. On phones each card fits its own text. */
  .meta {
    padding: 0.85rem 1rem 1rem;
  }

  /* The title takes the lines it needs (up to 2, clamped with an ellipsis
     past that); the Card Line (80-100 characters) always shows in full. */
  .card-title {
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--olympic-gold);
    transition: color 0.15s ease;
    max-height: 2.6em;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .line {
    margin: 0.4rem 0 0;
    color: var(--headlight);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .card:hover .card-title {
    color: var(--headlight);
  }
</style>
