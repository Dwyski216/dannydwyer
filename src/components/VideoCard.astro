---
interface Props {
  slug: string;
  title: string;
  // Shown under the title when given; the Work and category galleries leave
  // it out, so their cards are just thumbnail and title.
  summary?: string;
  tags: string[];
  thumbnailUrl: string;
  // Swapped in if thumbnailUrl fails to load (an uploaded thumbnail falls
  // back to the video platform's own).
  fallbackUrl?: string;
  // Rendered hidden (a category page shows only its own videos before the
  // filter script runs, so there's no flash of the full catalog).
  initiallyHidden?: boolean;
  // Its position in the Work page order, for galleries that re-sort cards.
  workRank?: number;
}
const { slug, title, summary, tags, thumbnailUrl, fallbackUrl, initiallyHidden = false, workRank } = Astro.props;
const searchText = `${title} ${summary ?? ''} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="card"
  href={`/work/${slug}`}
  data-slug={slug}
  data-work-rank={workRank}
  data-tags={tags.join('|').toLowerCase()}
  data-search={searchText}
  style={initiallyHidden ? 'display: none' : undefined}
>
  <div class="thumb">
    <img
      src={thumbnailUrl}
      alt={title}
      loading="lazy"
      width="480"
      height="270"
      data-fallback={fallbackUrl}
      onerror={fallbackUrl ? 'this.onerror=null;this.src=this.dataset.fallback' : undefined}
    />
  </div>
  <div class="meta">
    <h3>{title}</h3>
    {summary && <p class="summary">{summary}</p>}
    <div class="tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: filter 0.2s ease;
  }

  .card:hover .thumb img {
    filter: grayscale(0);
  }

  .meta {
    padding: 0.85rem 1rem 1rem;
  }

  /* The title takes only the lines it needs (up to 2, clamped with an
     ellipsis), so the summary always sits the same 0.4rem below it whether
     the title is one line or two. The summary keeps a fixed 3-line height,
     and cards in a row stretch to equal height, so any extra space falls at
     the bottom of a card, never between title and summary. */
  .meta h3 {
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--olympic-gold);
    transition: color 0.15s ease;
    max-height: 2.6em;
    margin-bottom: 0.4rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  /* No summary: nothing below the title, so no gap under it either. */
  .meta h3:has(+ .tags) {
    margin-bottom: 0;
  }

  .card:hover h3 {
    color: var(--headlight);
  }

  .summary {
    color: var(--headlight);
    font-size: 0.85rem;
    line-height: 1.5;
    height: 4.5em;
    margin: 0 0 0.65rem;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .tags {
    display: none;
  }
</style>
