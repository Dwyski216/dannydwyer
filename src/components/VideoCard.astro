---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  thumbnailUrl: string;
  uploadDate: string;
}
const { slug, title, summary, tags, thumbnailUrl, uploadDate } = Astro.props;
const year = new Date(uploadDate).getFullYear();
const searchText = `${title} ${summary} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="card"
  href={`/work/${slug}`}
  data-tags={tags.join('|').toLowerCase()}
  data-search={searchText}
>
  <div class="thumb">
    <img src={thumbnailUrl} alt={title} loading="lazy" width="480" height="270" />
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <div class="tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
      <span class="year">{year}</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: filter 0.2s ease;
  }

  .card:hover .thumb img {
    filter: grayscale(0);
  }

  .meta {
    padding: 0.85rem 1rem 1rem;
  }

  /* Title and summary both get a fixed height matched to a line-clamp of
     the same line count (2 and 3 respectively — the catalog's longest
     titles/summaries run roughly 2x the average, so this covers the
     typical case in full and truncates the outliers with an ellipsis).
     Reserving the height (not just capping it) is what makes every card
     the same height regardless of content length — a short title still
     takes up its full 2-line slot instead of shrinking the card. */
  .meta h3 {
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 1rem;
    line-height: 1.3;
    height: 2.6em;
    margin-bottom: 0.4rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .card:hover h3 {
    color: var(--accent);
  }

  .summary {
    color: var(--headlight);
    font-size: 0.85rem;
    line-height: 1.5;
    height: 4.5em;
    margin: 0 0 0.65rem;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .tags {
    display: none;
  }
</style>
