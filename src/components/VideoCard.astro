---
interface Props {
  slug: string;
  title: string;
  // The video's Card Line, shown in full under the title. Never the SEO
  // summary: that stays in the project page's meta tags.
  line?: string;
  tags: string[];
  thumbnailUrl: string;
  // Swapped in if thumbnailUrl fails to load (an uploaded thumbnail falls
  // back to the video platform's own).
  fallbackUrl?: string;
  // Rendered hidden (a category page shows only its own videos before the
  // filter script runs, so there's no flash of the full catalog).
  initiallyHidden?: boolean;
  // Its position in the Work page order, for galleries that re-sort cards.
  workRank?: number;
}
const { slug, title, line, tags, thumbnailUrl, fallbackUrl, initiallyHidden = false, workRank } = Astro.props;
const searchText = `${title} ${line ?? ''} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="card"
  href={`/work/${slug}`}
  data-slug={slug}
  data-work-rank={workRank}
  data-tags={tags.join('|').toLowerCase()}
  data-search={searchText}
  style={initiallyHidden ? 'display: none' : undefined}
>
  <div class="thumb">
    <img
      src={thumbnailUrl}
      alt={title}
      loading="lazy"
      width="480"
      height="270"
      data-fallback={fallbackUrl}
      onerror={fallbackUrl ? 'this.onerror=null;this.src=this.dataset.fallback' : undefined}
    />
  </div>
  <div class="meta">
    <h3>{title}</h3>
    {line && <p class="line">{line}</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: filter 0.2s ease;
  }

  .card:hover .thumb img {
    filter: grayscale(0);
  }

  /* Room for a two-line title and a three-line Card Line on every card,
     so all cards are the same size; the Card Line sits right under the
     title, and any spare space falls at the bottom. (Padding 0.85 + 1rem,
     title 2 × 1.3rem, gap 0.4rem, Card Line 3 × 0.85 × 1.5rem.) */
  .meta {
    padding: 0.85rem 1rem 1rem;
    min-height: calc(1.85rem + 2.6rem + 0.4rem + 3.825rem);
  }

  /* The title takes the lines it needs (up to 2, clamped with an ellipsis
     past that); the Card Line (80-100 characters) always shows in full. */
  .meta h3 {
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--olympic-gold);
    transition: color 0.15s ease;
    max-height: 2.6em;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .line {
    margin: 0.4rem 0 0;
    color: var(--headlight);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .card:hover h3 {
    color: var(--headlight);
  }
</style>
