---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  thumbnailUrl: string;
  uploadDate: string;
}
const { slug, title, summary, tags, thumbnailUrl, uploadDate } = Astro.props;
const year = new Date(uploadDate).getFullYear();
const searchText = `${title} ${summary} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="card"
  href={`/work/${slug}`}
  data-tags={tags.join('|').toLowerCase()}
  data-search={searchText}
>
  <div class="thumb">
    <img src={thumbnailUrl} alt="" loading="lazy" width="480" height="270" />
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <div class="tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
      <span class="year">{year}</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: filter 0.2s ease;
  }

  .card:hover .thumb img {
    filter: grayscale(0);
  }

  .meta {
    padding: 0.85rem 1rem 1rem;
  }

  .meta h3 {
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 1rem;
    line-height: 1.3;
    margin-bottom: 0.4rem;
  }

  .card:hover h3 {
    color: var(--accent);
  }

  .summary {
    color: var(--headlight);
    font-size: 0.85rem;
    margin: 0 0 0.65rem;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .tags {
    display: none;
  }
</style>
