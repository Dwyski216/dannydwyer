---
// Work page section: the "Work" title + description paragraph above the
// filter controls and grid.
interface Props {
  description: string;
}
const { description } = Astro.props;
---

<section class="description-banner">
  <h1 class="page-title">Work</h1>
  <p class="description">{description}</p>
</section>

<style>
  .description-banner {
    /* Breathing room between the site header and the page title. */
    margin-top: 4rem;
    margin-bottom: 1.5rem;
  }

  .description-banner h1 {
    margin: 0 0 0.5rem;
  }

  .description {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
    text-align: justify;
    hyphens: auto;
  }
</style>
