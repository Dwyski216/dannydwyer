---
// Work page section: the "Work" title + description above the filter
// controls and grid. Both come from src/content/pages/work.md, edited in the
// admin's Work tab.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="description-banner">
  <h1 class="page-title">{title}</h1>
  <div class="description"><slot /></div>
</section>

<style>
  .description-banner {
    /* Breathing room between the site header and the page title; below,
       extra space so the category buttons sit in their own band. */
    margin-top: 4rem;
    margin-bottom: 3rem;
  }

  .description-banner h1 {
    margin: 0 0 0.5rem;
  }

  /* Phones: same spacing around the title as the Contact page (60px from
     the nav underline above, 52px to the description below). */
  @media (max-width: 600px) {
    .description-banner {
      margin-top: calc(4rem - 49px);
      margin-bottom: 2.5rem;
    }

    .description-banner h1 {
      margin-bottom: calc(0.5rem + 25px);
    }
  }

  /* Desktop: titles sit 36px closer to the nav (Work, Contact, 404 match). */
  @media (min-width: 601px) {
    .description-banner {
      margin-top: calc(4rem - 36px);
    }
  }

  /* Set like the Contact page's body copy (ContactBody.astro .prose). */
  .description {
    font-family: var(--font-body);
    color: color-mix(in srgb, var(--headlight) 88%, transparent);
    font-size: 1.1rem;
    line-height: 1.75;
    margin: 0;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .description :global(p) {
    margin: 0 0 1rem;
  }

  .description :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
