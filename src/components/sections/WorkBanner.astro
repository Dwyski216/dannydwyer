---
// Work page section: the "Work" title + description paragraph above the
// filter controls and grid.
interface Props {
  description: string;
}
const { description } = Astro.props;
---

<section class="description-banner">
  <h1 class="page-title">Work</h1>
  <p class="description">{description}</p>
</section>

<style>
  .description-banner {
    /* Breathing room between the site header and the page title. */
    margin-top: 4rem;
    margin-bottom: 1.5rem;
  }

  /* Overrides the shared .page-title Signature Treatment (Barn Red Futura
     with a Headlight drop shadow) for the Work page only: flat Headlight in
     Edmondsans Regular. */
  .description-banner h1 {
    font-family: 'Edmondsans', var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    margin: 0 0 0.5rem;
    color: var(--headlight);
    text-shadow: none;
  }

  .description {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
