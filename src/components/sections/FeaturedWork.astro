---
// Home page section: the Featured Work grid (picked in the admin panel by
// slug). Renders nothing if there's nothing to feature.
import VideoCard from '../VideoCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  featured: CollectionEntry<'videos'>[];
  thumbnails: string[];
}
const { featured, thumbnails } = Astro.props;
---

{featured.length > 0 && (
  <section class="featured col-12" aria-label="Featured work">
    <h2>Featured Work</h2>
    <div class="grid featured-grid">
      {featured.map((v, i) => (
        <div class="col-4">
          <VideoCard
            slug={v.data.urlSlug}
            title={v.data.title}
            summary={v.data.summary}
            tags={v.data.tags}
            thumbnailUrl={thumbnails[i]}
            uploadDate={v.data.uploadDate}
          />
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .featured {
    margin: 1.5rem 0 3rem;
  }

  /* Card titles in Olympic Gold, matching the Work page grid. The card's
     own hover rule turns titles Olympic Gold, which would be no change
     here, so hover flips them to Headlight instead. */
  .featured :global(.meta h3) {
    color: var(--olympic-gold);
  }

  .featured :global(.card:hover h3) {
    color: var(--headlight);
  }

  .featured h2 {
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--headlight);
    margin-bottom: 1.25rem;
  }

  .featured-grid {
    row-gap: 2rem;
  }
</style>
