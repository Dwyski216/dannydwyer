---
// Home page section: the Featured Work grid (picked in the admin panel by
// slug). Renders nothing if there's nothing to feature.
import VideoCard from '../VideoCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  featured: CollectionEntry<'videos'>[];
  thumbnails: string[];
}
const { featured, thumbnails } = Astro.props;
---

{featured.length > 0 && (
  <section class="featured col-12" aria-label="Featured work">
    <h2>Featured Work</h2>
    <div class="grid featured-grid">
      {featured.map((v, i) => (
        <div class="col-4">
          <VideoCard
            slug={v.data.urlSlug}
            title={v.data.title}
            summary={v.data.summary}
            tags={v.data.tags}
            thumbnailUrl={thumbnails[i]}
            uploadDate={v.data.uploadDate}
          />
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .featured {
    /* Generous gap below the bio's Collection of Work button. */
    margin: 4.5rem 0 3rem;
  }

  .featured h2 {
    /* Edmondsans Regular, all caps, centered, like the bio title above;
       sized 15% up from its original size. */
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: min(calc((clamp(1.15rem, 2.3vw, 1.6rem) + 5pt) * 1.15), 6.9vw);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--headlight);
    margin-bottom: 1.25rem;
  }

  .featured-grid {
    row-gap: 2rem;
  }
</style>
