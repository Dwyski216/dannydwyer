---
// Contact page section: the page title, photo, copy and CTA composition.
// The title lives here (not as its own section) so it can sit over the copy
// on desktop while still leading the page on phones.
interface Props {
  title: string;
  email: string;
}
const { title, email } = Astro.props;
---

<div class="layout">
  <h1 class="page-title contact-title">{title}</h1>

  <div class="photo-col">
    <img
      class="photo"
      src="/images/dwyer-sunglasses.webp"
      alt="Danny Dwyer, cinematographer, in sunglasses behind a Sony cinema camera"
      width="1200"
      height="1600"
      loading="eager"
    />
  </div>

  <div class="copy-col">
    <div class="prose">
      <slot />
    </div>

    <div class="action">
      <a class="button" href={`mailto:${email}`}>Get in touch</a>
      <a class="email-plain" href={`mailto:${email}`}>{email}</a>
    </div>
  </div>
</div>

<style>
  /* Phones: title, then photo, then copy, stacked. Desktop: photo on the
     left; the title sits over the copy on the right, its top level with the
     photo's. The 4rem top margin matches the Work page title's distance
     from the site header. */
  .layout {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'title'
      'photo'
      'copy';
    row-gap: 2.5rem;
    margin-top: 4rem;
  }

  .contact-title {
    grid-area: title;
  }

  .photo-col {
    grid-area: photo;
  }

  .copy-col {
    grid-area: copy;
  }

  @media (min-width: 801px) {
    .layout {
      grid-template-columns: 37.8% 1fr;
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'photo title'
        'photo copy';
      column-gap: clamp(2rem, 5vw, 4rem);
      row-gap: 0;
      align-items: start;
    }
  }

  /* Phones/tablets (stacked layout): about three-quarters of full width. */
  .photo-col {
    width: 73.8%;
    max-width: 310px;
    margin-inline: auto;
  }

  @media (min-width: 801px) {
    .photo-col {
      width: 100%;
      max-width: none;
      margin-inline: 0;
    }
  }

  /* Photo framed with a 2pt Headlight border, no shadow. */
  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    box-sizing: border-box;
    border: 2pt solid var(--headlight);
  }

  .copy-col {
    min-width: 0;
  }

  .prose {
    font-family: var(--font-body);
    color: color-mix(in srgb, var(--headlight) 88%, transparent);
    font-size: 1.1rem;
    line-height: 1.75;
    max-width: 68ch;
    margin-top: 1.5rem;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .prose :global(p) {
    margin: 0 0 1.1rem;
  }

  .prose :global(a) {
    color: var(--olympic-gold);
    text-decoration: underline;
  }

  .action {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  /* Hollow Headlight button, matching the home page's "Collection of Work":
     2pt outline, filling Olympic Gold with Ink text on hover. */
  .button {
    display: inline-block;
    background: transparent;
    border: 2pt solid var(--headlight);
    color: var(--headlight);
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    padding: 0.9rem 1.75rem;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .button:hover {
    background: var(--olympic-gold);
    border-color: var(--olympic-gold);
    color: var(--ink);
  }

  /* Email set like the body copy above it; Olympic Gold on hover. */
  .email-plain {
    font-family: var(--font-body);
    color: color-mix(in srgb, var(--headlight) 88%, transparent);
    font-size: 1.1rem;
    line-height: 1.75;
    transition: color 0.15s ease;
  }

  .email-plain:hover {
    color: var(--olympic-gold);
  }

  /* Desktop: visible space from the title down to the copy matches the
     space from the copy down to the Get in touch button. */
  @media (min-width: 801px) {
    .prose {
      margin-top: 1.125rem;
    }
  }
</style>
