---
// Contact page section: the two-column photo + copy + CTA composition.
// Kept as one section (not split further) because the photo, the copy,
// and the button are a deliberately choreographed unit — letting the admin
// reorder its pieces independently risks nonsensical combinations.
interface Props {
  email: string;
  location: string;
}
const { email, location } = Astro.props;
---

<div class="layout">
  <div class="photo-col">
    <div class="photo-frame">
      <img
        class="photo"
        src="/images/dwyer-sunglasses.webp"
        alt="Danny Dwyer, cinematographer, in sunglasses behind a Sony cinema camera"
        width="1200"
        height="1600"
        loading="eager"
      />
    </div>
  </div>

  <div class="copy-col">
    <div class="prose">
      <slot />
    </div>

    <div class="action">
      <a class="button" href={`mailto:${email}`}>Get in touch</a>
      <a class="email-plain" href={`mailto:${email}`}>{email}</a>
      {location && <span class="location">{location}</span>}
    </div>
  </div>
</div>

<style>
  .layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 801px) {
    .layout {
      /* photo-col is first in the DOM, so it stacks on top on mobile and
         sits on the left on desktop, with the copy to its right. */
      flex-direction: row;
      align-items: flex-start;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  /* Phones/tablets (stacked layout): 18% smaller than full width. */
  .photo-col {
    flex: 0 0 auto;
    width: 82%;
    max-width: 344px;
    margin-inline: auto;
    /* Phones: a little air between the page title and the photo. */
    margin-top: 1rem;
  }

  @media (min-width: 801px) {
    .photo-col {
      flex-basis: 42%;
      width: 100%;
      max-width: none;
      margin-inline: 0;
      margin-top: 0;
    }
  }

  /* Photo framed with a 2pt Headlight border, no shadow. */
  .photo-frame {
    position: relative;
  }

  .photo {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    box-sizing: border-box;
    border: 2pt solid var(--headlight);
  }

  .copy-col {
    flex: 1 1 auto;
    min-width: 0;
  }

  .prose {
    font-family: var(--font-body);
    color: color-mix(in srgb, var(--headlight) 88%, transparent);
    font-size: 1.1rem;
    line-height: 1.75;
    max-width: 68ch;
    margin-top: 1.5rem;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .prose :global(p) {
    margin: 0 0 1.1rem;
  }

  .prose :global(a) {
    color: var(--olympic-gold);
    text-decoration: underline;
  }

  .action {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .button {
    display: inline-block;
    background: var(--olympic-gold);
    color: var(--on-accent);
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    padding: 0.9rem 1.75rem;
    transition: background 0.15s ease;
  }

  .button:hover {
    background: var(--accent-dim);
  }

  .email-plain {
    color: color-mix(in srgb, var(--headlight) 75%, transparent);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .location {
    color: color-mix(in srgb, var(--headlight) 60%, transparent);
    font-size: 0.85rem;
  }

</style>
