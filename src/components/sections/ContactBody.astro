---
// Contact page section: the page title, photo, copy and CTA composition.
// The title lives here (not as its own section) so it can sit over the copy
// on desktop while still leading the page on phones.
interface Props {
  email: string;
  location: string;
}
const { email, location } = Astro.props;
---

<div class="layout">
  <h1 class="page-title contact-title">Contact</h1>

  <div class="photo-col">
    <div class="photo-frame">
      <img
        class="photo"
        src="/images/dwyer-sunglasses.webp"
        alt="Danny Dwyer, cinematographer, in sunglasses behind a Sony cinema camera"
        width="1200"
        height="1600"
        loading="eager"
      />
    </div>
  </div>

  <div class="copy-col">
    <div class="prose">
      <slot />
    </div>

    <div class="action">
      <a class="button" href={`mailto:${email}`}>Get in touch</a>
      <a class="email-plain" href={`mailto:${email}`}>{email}</a>
      {location && <span class="location">{location}</span>}
    </div>
  </div>
</div>

<style>
  /* Phones: title, then photo, then copy, stacked. Desktop: photo on the
     left; the title sits over the copy on the right, its top level with the
     photo's. The 4rem top margin matches the Work page title's distance
     from the site header. */
  .layout {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'title'
      'photo'
      'copy';
    row-gap: 2.5rem;
    margin-top: 4rem;
  }

  .contact-title {
    grid-area: title;
  }

  .photo-col {
    grid-area: photo;
  }

  .copy-col {
    grid-area: copy;
  }

  @media (min-width: 801px) {
    .layout {
      grid-template-columns: 37.8% 1fr;
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'photo title'
        'photo copy';
      column-gap: clamp(2rem, 5vw, 4rem);
      row-gap: 1.5rem;
      align-items: start;
    }
  }

  /* Phones/tablets (stacked layout): about three-quarters of full width. */
  .photo-col {
    width: 73.8%;
    max-width: 310px;
    margin-inline: auto;
  }

  @media (min-width: 801px) {
    .photo-col {
      width: 100%;
      max-width: none;
      margin-inline: 0;
    }
  }

  /* Photo framed with a 2pt Headlight border, no shadow. */
  .photo-frame {
    position: relative;
  }

  .photo {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    box-sizing: border-box;
    border: 2pt solid var(--headlight);
  }

  .copy-col {
    min-width: 0;
  }

  .prose {
    font-family: var(--font-body);
    color: color-mix(in srgb, var(--headlight) 88%, transparent);
    font-size: 1.1rem;
    line-height: 1.75;
    max-width: 68ch;
    margin-top: 1.5rem;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .prose :global(p) {
    margin: 0 0 1.1rem;
  }

  .prose :global(a) {
    color: var(--olympic-gold);
    text-decoration: underline;
  }

  .action {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .button {
    display: inline-block;
    background: var(--olympic-gold);
    color: var(--on-accent);
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    padding: 0.9rem 1.75rem;
    transition: background 0.15s ease;
  }

  .button:hover {
    background: var(--accent-dim);
  }

  .email-plain {
    color: color-mix(in srgb, var(--headlight) 75%, transparent);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .location {
    color: color-mix(in srgb, var(--headlight) 60%, transparent);
    font-size: 0.85rem;
  }

</style>
