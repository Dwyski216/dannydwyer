---
// Work page section: preset filter buttons, search, and the tag filter
// panel. The client-side filtering script lives in work/index.astro itself
// (not here) since it coordinates this section with WorkGrid's #video-list
// — see the comment there for why, and how it degrades if either section
// is disabled.
interface Props {
  allTags: string[];
}
const { allTags } = Astro.props;
---

<div class="controls">
  <div class="preset-filters">
    <a class="preset-btn" href="/work/?tag=branded%20content">Branded Content</a>
    <a class="preset-btn" href="/work/?tag=celebrity">Celebrity</a>
    <a class="preset-btn" href="/work/?tag=fashion">Fashion</a>
    <a class="preset-btn" href="/work/?tag=documentary">Documentary</a>
  </div>

  <div class="filter-row">
    <input id="search" type="search" placeholder="Search by title, client, or keyword…" aria-label="Search videos" />

    <button type="button" id="filters-toggle" class="filters-toggle" aria-expanded="false" aria-controls="filters-panel">
      Filters
      <span id="filters-badge" class="badge" hidden>0</span>
    </button>
  </div>
</div>

<div id="selected-chips" class="selected-chips"></div>

<div id="filters-panel" class="filters-panel" hidden>
  <div class="filters-panel-tags">
    {allTags.map((tag) => (
      <button type="button" class="tag-toggle" data-tag={tag.toLowerCase()} aria-pressed="false">
        {tag}
      </button>
    ))}
  </div>
  <div class="filters-panel-actions">
    <button type="button" id="filters-clear" class="btn btn-ghost">Clear All</button>
    <button type="button" id="filters-apply" class="btn btn-solid">Apply</button>
  </div>
</div>

<style>
  .preset-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
  }

  .preset-btn {
    display: block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.6rem 1rem;
    text-align: left;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .preset-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  #search {
    font-family: var(--font-body);
    background: var(--surface);
    /* A 0.5pt Headlight hairline. Browsers round real borders under 1px
       up to a full pixel, so it's drawn as an outline instead, which
       Retina/phone screens render at true half-point thickness. The clear
       1px border keeps the box its original size. */
    border: 1px solid transparent;
    box-shadow: 0 0 0 0.5pt var(--headlight);
    color: var(--text);
    padding: 0.6rem 0.8rem;
    font-size: 0.95rem;
    flex: 1 1 220px;
  }

  #search:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .filter-row {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.75rem;
    flex: 0 0 auto;
  }

  /* Phones: stack the row with Filters first and the search box last,
     full width, at the bottom of the controls cluster. */
  @media (max-width: 600px) {
    .filter-row {
      flex: 1 1 100%;
      flex-direction: column;
      align-items: flex-start;
    }

    .filters-toggle {
      order: -1;
    }

    #search {
      flex: 0 0 auto;
      width: 100%;
      box-sizing: border-box;
    }
  }

  .filters-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .filters-toggle:hover {
    border-color: var(--text-muted);
  }

  .filters-toggle[aria-expanded='true'] {
    border-color: var(--accent);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.2rem;
    height: 1.2rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .badge[hidden] {
    display: none;
  }

  .selected-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .selected-chips:not(:empty) {
    margin-bottom: 1.5rem;
  }

  /* Chips are created by the filter script in work/index.astro, so they
     don't carry this component's scoped-style attribute — hence :global,
     kept inside .selected-chips so it can't leak anywhere else. */
  .selected-chips :global(.selected-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--on-accent);
    background: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.3rem 0.7rem;
    cursor: pointer;
  }

  .selected-chips :global(.selected-chip:hover) {
    background: var(--accent-dim);
    border-color: var(--accent-dim);
  }

  .selected-chips :global(.selected-chip span) {
    font-size: 0.95rem;
    line-height: 1;
  }

  .filters-panel {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  .filters-panel-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    max-height: 260px;
    overflow-y: auto;
    padding-bottom: 1rem;
  }

  .tag-toggle {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .tag-toggle:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .tag-toggle.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .filters-panel-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .btn {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.55rem 1.2rem;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-ghost {
    background: none;
    border-color: var(--hairline);
    color: var(--text-muted);
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .btn-solid {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .btn-solid:hover {
    background: var(--accent-dim);
    border-color: var(--accent-dim);
  }
</style>
