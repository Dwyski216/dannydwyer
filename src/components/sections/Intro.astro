---
// Home page section: the bio heading + rich-text intro copy + CTA into Work.
interface Props {
  role: string;
  introCopy: string;
}
const { role, introCopy } = Astro.props;
---

<section class="intro col-12">
  <h1>{role}</h1>
  <div class="intro-copy" set:html={introCopy} />
  <a class="cta" href="/work">View the work &nbsp;→</a>
</section>

<style>
  .intro {
    margin: 3rem 0 1rem;
  }

  .intro h1 {
    /* +10pt over the base size; capped at 7.8vw so "CINEMATOGRAPHER" never
       overflows a narrow phone screen. */
    font-size: min(calc(clamp(1.15rem, 2.3vw, 1.6rem) + 10pt), 7.8vw);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    margin-bottom: 1rem;
  }

  .intro-copy {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.5;
    text-align: justify;
    hyphens: auto;
  }

  /* The bio is rich text from the admin editor. Text pasted in from other
     apps can carry inline fonts, sizes and colors; force every element
     inside it back to the site's own typography so it always reads as one
     block. Bold/italic/links still work (weight, style and the link rule
     below aren't overridden). */
  .intro-copy :global(*) {
    color: inherit !important;
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    background: none !important;
  }

  .intro-copy :global(p) {
    margin: 0 0 1.2em !important;
  }

  .intro-copy :global(p:last-child) {
    margin-bottom: 0 !important;
  }

  .intro-copy :global(a) {
    color: var(--accent) !important;
    text-decoration: underline;
  }

  .cta {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    padding-bottom: 0.15rem;
  }
</style>
