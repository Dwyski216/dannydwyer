---
// Home page section: the bio heading + rich-text intro copy + CTAs (email
// and into Work).
interface Props {
  role: string;
  introCopy: string;
  email: string;
}
const { role, introCopy, email } = Astro.props;
---

<section class="intro col-12">
  <h1>{role}</h1>
  <div class="intro-copy" set:html={introCopy} />
  <div class="actions">
    <a class="button" href={`mailto:${email}`}>Give Me A Shout</a>
    <a class="cta" href="/work">Peep the work &nbsp;→</a>
  </div>
</section>

<style>
  .intro {
    margin: 3rem 0 1rem;
  }

  .intro h1 {
    /* Capped at 6vw so the longest word, "CINEMATOGRAPHER", always fits a
       phone screen with room to spare; overflow-wrap is a last-resort guard
       so the page can never scroll sideways. */
    font-size: min(calc(clamp(1.15rem, 2.3vw, 1.6rem) + 5pt), 6vw);
    overflow-wrap: anywhere;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    /* Original 1rem gap plus one blank bio line (1.05rem text x 1.5 line
       height), so the title sits a clear line above the bio. */
    margin-bottom: calc(1rem + 1.05rem * 1.5);
  }

  .intro-copy {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.5;
    text-align: justify;
    hyphens: auto;
  }

  /* The bio is rich text from the admin editor. Text pasted in from other
     apps can carry inline fonts, sizes and colors; force every element
     inside it back to the site's own typography so it always reads as one
     block. Bold/italic/links still work (weight, style and the link rule
     below aren't overridden). */
  .intro-copy :global(*) {
    color: inherit !important;
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    background: none !important;
  }

  .intro-copy :global(p) {
    margin: 0 0 1.2em !important;
  }

  .intro-copy :global(p:last-child) {
    margin-bottom: 0 !important;
  }

  .intro-copy :global(a) {
    color: var(--accent) !important;
    text-decoration: underline;
  }

  /* Button centered under the bio (matching the centered title); the
     "Peep the work" link sits flush with the bio's right edge. The empty
     first column mirrors the link's column so the button stays truly
     centered. On narrow screens they stack: button centered, link below it
     on the right. */
  .actions {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .actions .button {
    grid-column: 2;
  }

  .actions .cta {
    grid-column: 3;
    justify-self: end;
  }

  @media (max-width: 600px) {
    .actions {
      grid-template-columns: 1fr;
    }

    .actions .button {
      grid-column: 1;
      justify-self: center;
    }

    .actions .cta {
      grid-column: 1;
    }
  }

  /* Hollow Olympic Gold button: 2pt outline and gold text on the page
     background. Fills gold on hover. */
  .button {
    display: inline-block;
    background: transparent;
    border: 2pt solid var(--olympic-gold);
    color: var(--olympic-gold);
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    padding: 0.9rem 1.75rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .button:hover {
    background: var(--olympic-gold);
    color: var(--on-accent);
  }

  .cta {
    display: inline-block;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    padding-bottom: 0.15rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .cta:hover {
    color: var(--headlight);
    border-bottom-color: var(--headlight);
  }
</style>
