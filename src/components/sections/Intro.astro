---
// Home page section: the bio heading + rich-text intro copy + a CTA button
// into Work.
interface Props {
  role: string;
  introCopy: string;
}
const { role, introCopy } = Astro.props;
---

<section class="intro col-12">
  <h1>{role}</h1>
  <div class="intro-copy" set:html={introCopy} />
  <div class="actions">
    <a class="button" href="/work">Collection of Work</a>
  </div>
</section>

<style>
  .intro {
    margin: 3rem 0 1rem;
  }

  .intro h1 {
    /* 50px on desktop, scaling down with the screen; capped at 7.02vw so
       the longest word, "CINEMATOGRAPHER", still fits a phone
       screen; overflow-wrap is a last-resort guard so the page can never
       scroll sideways. */
    font-size: min(calc(clamp(2.5rem, 5.5vw, 3.5rem) * 0.9), 7.02vw);
    overflow-wrap: anywhere;
    font-family: var(--font-title-light);
    font-weight: 300;
    color: var(--olympic-gold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    /* Original 1rem gap plus one blank bio line (1.05rem text x 1.5 line
       height), so the title sits a clear line above the bio. */
    margin-bottom: calc(1rem + 1.05rem * 1.5);
  }

  .intro-copy {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.5;
    text-align: justify;
    hyphens: auto;
  }

  /* The bio is rich text from the admin editor. Text pasted in from other
     apps can carry inline fonts, sizes and colors; force every element
     inside it back to the site's own typography so it always reads as one
     block. Bold/italic/links still work (weight, style and the link rule
     below aren't overridden). */
  .intro-copy :global(*) {
    color: inherit !important;
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    background: none !important;
  }

  .intro-copy :global(p) {
    margin: 0 0 1.2em !important;
  }

  .intro-copy :global(p:last-child) {
    margin-bottom: 0 !important;
  }

  .intro-copy :global(a) {
    color: var(--accent) !important;
    text-decoration: underline;
  }

  /* Button centered under the bio, matching the centered title. */
  /* The button sits centered in the space between the bio and the
     Featured Work heading below (see FeaturedWork.astro's top margin). */
  .actions {
    display: flex;
    justify-content: center;
    margin-top: 4.5rem;
  }

  /* Hollow Headlight button: 2pt outline and text on the page background,
     filling Olympic Gold with Ink text on hover. */
  .button {
    display: inline-block;
    background: transparent;
    border: 2pt solid var(--headlight);
    color: var(--headlight);
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    padding: 0.9rem 1.75rem;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .button:hover {
    background: var(--olympic-gold);
    border-color: var(--olympic-gold);
    color: var(--ink);
  }
</style>
