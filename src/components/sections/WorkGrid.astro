---
// Work page section: the video card grid itself, plus the "no matches"
// empty state the controls-section script toggles.
import VideoCard from '../VideoCard.astro';
import type { CollectionEntry } from 'astro:content';
import type { Thumbnail } from '../../lib/video';

interface Props {
  videos: CollectionEntry<'videos'>[];
  thumbnails: Thumbnail[];
  initialTag?: string; // category pages: show only this tag's videos at first
  workRanks: number[]; // each video's position in the Work page order
}
const { videos, thumbnails, initialTag, workRanks } = Astro.props;
---

<div class="video-area">
  <div id="video-list" class="card-gallery">
    {videos.map((v, i) => (
      <VideoCard
        slug={v.data.urlSlug}
        title={v.data.title}
        tags={v.data.tags}
        thumbnailUrl={thumbnails[i].src}
        fallbackUrl={thumbnails[i].fallback}
        initiallyHidden={!!initialTag && !v.data.tags.some((t) => t.toLowerCase() === initialTag)}
        workRank={workRanks[i]}
      />
    ))}
  </div>

  <p id="empty-state" hidden>No videos match your search yet.</p>
</div>

<style>
  #empty-state {
    color: var(--text-muted);
    padding: 2rem 0;
    text-align: center;
  }
</style>
