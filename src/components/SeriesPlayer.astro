---
// A work item that's a series: the first video plays in the big player,
// the rest sit in a thumbnail strip right under it. Clicking a thumbnail
// loads that video into the big player (and starts it), and the video that
// was playing takes the thumbnail's place in the strip.
import { getEmbedUrl, type VideoPlatform } from '../lib/video';

interface SeriesVideo {
  platform: VideoPlatform;
  videoId: string;
  title: string;
  src: string; // thumbnail
  fallback?: string; // shown if an uploaded thumbnail fails to load
}

interface Props {
  videos: SeriesVideo[];
}
const { videos } = Astro.props;
const [main, ...rest] = videos;

// One allow list covering both platforms, since a series can mix them and
// any video can end up in the big player.
// Swaps in the platform thumbnail if an uploaded one fails to load. Not a
// one-shot (the strip's images change as videos swap): a flag stops it
// retrying, and the swap script clears the flag with each new image.
const FALLBACK_ONERROR =
  "if(this.dataset.fallback&&!this.dataset.fellBack){this.dataset.fellBack='1';this.src=this.dataset.fallback}";

const allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture';
---

<div class="series-player" data-series-player>
  <div class="embed-wrap">
    <iframe
      src={getEmbedUrl(main)}
      title={main.title}
      allow={allow}
      allowfullscreen
      data-embed={getEmbedUrl(main)}
      data-thumb={main.src}
      data-fallback={main.fallback ?? ''}
    ></iframe>
  </div>

  <div class="series-strip">
    {rest.map((v) => (
      <button
        type="button"
        class="series-thumb"
        data-embed={getEmbedUrl(v)}
        data-title={v.title}
        aria-label={`Play ${v.title}`}
      >
        <span class="series-thumb-frame">
          <img
            src={v.src}
            alt=""
            loading="lazy"
            width="320"
            height="180"
            data-thumb={v.src}
            data-fallback={v.fallback ?? ''}
            onerror={FALLBACK_ONERROR}
          />
          <span class="play" aria-hidden="true"></span>
        </span>
        <span class="series-thumb-title">{v.title}</span>
      </button>
    ))}
  </div>
</div>

<script>
  function withAutoplay(embedUrl: string): string {
    const url = new URL(embedUrl);
    url.searchParams.set('autoplay', '1');
    return url.toString();
  }

  document.querySelectorAll<HTMLElement>('[data-series-player]').forEach((player) => {
    const frame = player.querySelector('iframe')!;

    player.querySelectorAll<HTMLButtonElement>('.series-thumb').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const img = thumb.querySelector('img')!;
        const label = thumb.querySelector('.series-thumb-title')!;
        const playing = { embed: frame.dataset.embed!, thumb: frame.dataset.thumb!, fallback: frame.dataset.fallback!, title: frame.title };

        frame.src = withAutoplay(thumb.dataset.embed!);
        frame.dataset.embed = thumb.dataset.embed;
        // The big player keeps the thumbnail as it was uploaded (not a
        // fallback it may have swapped to), so it can be tried again later.
        frame.dataset.thumb = img.dataset.thumb;
        frame.dataset.fallback = img.dataset.fallback;
        frame.title = thumb.dataset.title!;

        thumb.dataset.embed = playing.embed;
        thumb.dataset.title = playing.title;
        label.textContent = playing.title;
        thumb.setAttribute('aria-label', `Play ${playing.title}`);
        img.dataset.fallback = playing.fallback;
        img.dataset.thumb = playing.thumb;
        delete img.dataset.fellBack;
        img.src = playing.thumb;

        // On phones the big player may be scrolled partly off screen.
        if (frame.getBoundingClientRect().top < 0) frame.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  });
</script>

<style>
  .embed-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .embed-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Up to four per row (three on phones), each row centered under the
     player: a fifth video starts a new row, and a short row stays centered. */
  .series-strip {
    --per-row: 4;
    --gap: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    margin-top: var(--gap);
  }

  @media (max-width: 600px) {
    .series-strip {
      --per-row: 3;
      --gap: 0.6rem;
    }
  }

  /* Each thumbnail with its video's title underneath. */
  .series-thumb {
    display: block;
    flex: 0 0 calc((100% - (var(--per-row) - 1) * var(--gap)) / var(--per-row));
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }

  .series-thumb-frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hairline);
    background: #000;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  /* Headlight, semi-bold: Trade Gothic has no semi-bold cut, so a hairline
     stroke thickens the regular (same as the nav's current page). */
  .series-thumb-title {
    display: block;
    margin-top: 0.45rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--headlight);
    -webkit-text-stroke: 0.035em currentColor;
    transition: color 0.15s ease;
  }

  .series-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .series-thumb:hover .series-thumb-frame,
  .series-thumb:focus-visible .series-thumb-frame {
    border-color: var(--olympic-gold);
    outline: 1px solid var(--olympic-gold);
  }

  .series-thumb:focus-visible {
    outline: none;
  }

  .series-thumb:hover .series-thumb-title {
    color: var(--olympic-gold);
  }

  /* Small play button so the thumbnails read as playable. */
  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.25rem;
    height: 2.25rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 65%, transparent);
    border: 1.5px solid var(--headlight);
    transition: border-color 0.15s ease;
  }

  .play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 0.4rem 0 0.4rem 0.65rem;
    border-color: transparent transparent transparent var(--headlight);
    transition: border-color 0.15s ease;
  }

  .series-thumb:hover .play {
    border-color: var(--olympic-gold);
  }

  .series-thumb:hover .play::after {
    border-left-color: var(--olympic-gold);
  }

  @media (max-width: 600px) {
    .play {
      width: 1.75rem;
      height: 1.75rem;
    }

    .play::after {
      border-width: 0.32rem 0 0.32rem 0.5rem;
    }
  }
</style>
