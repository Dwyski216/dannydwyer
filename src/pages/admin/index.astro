  // Accepts a Vimeo/YouTube link or a bare ID and works out which platform
  // it is. Vimeo IDs are all digits; YouTube IDs are 11 letters/digits/-/_.
  function parseVideoRef(input: string): { platform: 'vimeo' | 'youtube'; videoId: string } | null {
    const v = input.trim();
    if (!v) return null;
    const yt = v.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/)([\w-]{11})/);
    if (yt) return { platform: 'youtube', videoId: yt[1] };
    const vimeo = v.match(/vimeo\.com\/(?:.*\/)?(\d{6,})/) || v.match(/^(\d{6,})$/);
    if (vimeo) return { platform: 'vimeo', videoId: vimeo[1] };
    if (/^[\w-]{11}$/.test(v)) return { platform: 'youtube', videoId: v };
    return null;
  }

  function videoLink(platform: string, videoId: string): string {
    return platform === 'youtube' ? `https://youtu.be/${videoId}` : `https://vimeo.com/${videoId}`;
  }

  function parseRawVideo(raw: string): Record<string, any> {
    const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
    if (!match) return { description: raw };
    const [, fm, body] = match;
    const fields: Record<string, any> = { description: body.trim() };
    fm.split('\n').forEach((line) => {
      if (line.trim().startsWith('#') || !line.trim()) return;
      const idx = line.indexOf(':');
      if (idx === -1) return;
      const key = line.slice(0, idx).trim();
      const value = line.slice(idx + 1).trim();
      if (value.startsWith('[') || value.startsWith('{')) {
        try {
          fields[key] = JSON.parse(value);
        } catch {
          fields[key] = [];
        }
      } else if (value === 'true' || value === 'false') {
        fields[key] = value === 'true';
      } else if (value.startsWith('"') && value.endsWith('"')) {
        try {
          fields[key] = JSON.parse(value);
        } catch {
          fields[key] = value.replace(/^"|"$/g, '');
        }
      } else {
        fields[key] = value;
      }
    });
    return fields;
  }

