            </label>
            <button type="button" class="btn-move" data-row-up="${i}" ${i === 0 ? 'disabled' : ''} aria-label="Move up">↑</button>
            <button type="button" class="btn-move" data-row-down="${i}" ${i === items.length - 1 ? 'disabled' : ''} aria-label="Move down">↓</button>
            <button type="button" class="credit-remove" data-row-remove="${i}" aria-label="Remove">×</button>
          </div>${opts.extraRow ? opts.extraRow(row, i) : ''}`
            )
            .join('')
        : `<p class="section-hint">${escapeHtml(opts.emptyText)}</p>`;

      opts.listEl.querySelectorAll('[data-row-remove]').forEach((btn) => {
        btn.addEventListener('click', () => {
          items.splice(Number((btn as HTMLElement).dataset.rowRemove), 1);
          markDirty('work-item-form');
          render();
        });
      });
      opts.listEl.querySelectorAll('[data-row-up]').forEach((btn) => {
        btn.addEventListener('click', () => {
