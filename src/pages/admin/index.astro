---
// The Worker (worker/index.ts) gates every request to this page against a
// signed session cookie before it's ever served — see the `run_worker_first`
// note in wrangler.jsonc. No auth logic lives here; this page just assumes
// it's already authenticated.
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../data/categories';
---

<Layout title="Admin" description="Site content admin." noindex={true}>
  <main class="admin container">
    <div class="admin-header">
      <h1>Site Admin</h1>
      <button type="button" id="logout-btn" class="btn btn-ghost">Log Out</button>
    </div>
    <p class="hint">Changes here commit directly to the site's GitHub repo and trigger a live redeploy (usually live within a minute or two).</p>

    <div class="admin-layout">
      <aside class="admin-nav">
        <nav>
          <button type="button" class="nav-link active" data-page="home">Home</button>
          <button type="button" class="nav-link" data-page="work">Work</button>
          <button type="button" class="nav-link" data-page="contact">Contact</button>
          <button type="button" class="nav-link" data-page="tags">Tags</button>
          <button type="button" class="nav-link" data-page="seo">SEO</button>
          <button type="button" class="nav-link" data-page="settings">Settings</button>
        </nav>
      </aside>

      <div class="admin-content">
        <!-- ============ HOME ============ -->
        <section id="page-home" class="page-panel" data-page="home">
          <h2>Home page</h2>
          <p class="section-hint">Mirrors the home page top to bottom: the video that plays there, the intro text below it, then the Featured Work row.</p>

          <form id="home-form">
            <fieldset>
              <legend>Hero video</legend>
              <p class="section-hint">The video embedded at the top of the home page. Picked from the Work catalog — including hidden items, so a temporary reel can be used without showing up in the Work grid.</p>
              <label>Video
                <select name="heroSlug" id="hero-select">
                  <option value="">— None —</option>
                </select>
              </label>
            </fieldset>

            <fieldset>
              <legend>Intro</legend>
              <label>Heading <input name="pageHeading" required /></label>
              <div class="field-group">
                <span class="field-label">Description</span>
                <div class="richtext-toolbar" data-target="intro-editor">
                  <button type="button" data-cmd="bold" aria-label="Bold"><b>B</b></button>
                  <button type="button" data-cmd="italic" aria-label="Italic"><i>I</i></button>
                  <button type="button" data-cmd="createLink" aria-label="Insert link">Link</button>
                  <button type="button" data-cmd="formatBlock" data-value="p" aria-label="Paragraph">¶</button>
                </div>
                <div id="intro-editor" class="richtext-editor" contenteditable="true"></div>
              </div>
              <textarea name="introCopy" id="intro-html" hidden></textarea>
            </fieldset>

            <fieldset>
              <legend>Featured Work</legend>
              <p class="section-hint">
                Pick which work items show in the Featured Work row. Click an item then use the arrows to move it, or
                double-click to move it directly. Drag items in the Selected box to reorder them.
              </p>
              <div class="dual-list">
                <div class="dual-list-col">
                  <div class="dual-list-label">All items</div>
                  <div id="featured-available" class="dual-list-box">
                    <p class="section-hint">Loading…</p>
                  </div>
                </div>
                <div class="dual-list-arrows">
                  <button type="button" id="featured-add-btn" class="btn btn-ghost" aria-label="Add to Featured Work">›</button>
                  <button type="button" id="featured-remove-btn" class="btn btn-ghost" aria-label="Remove from Featured Work">‹</button>
                </div>
                <div class="dual-list-col">
                  <div class="dual-list-label">Selected (drag to reorder)</div>
                  <div id="featured-selected" class="dual-list-box"></div>
                </div>
              </div>
            </fieldset>

            <button type="submit" class="btn btn-solid">Save Home Page</button>
            <p class="status" id="home-status"></p>
          </form>
        </section>

        <!-- ============ WORK ============ -->
        <section id="page-work" class="page-panel" data-page="work" hidden>
          <h2>Work</h2>
          <p class="section-hint">Add, edit, and delete work items, and manage the tags used to filter them.</p>

          <div id="work-list-view">
            <h3>Work page</h3>
            <p class="section-hint">Mirrors the work page: the heading, then the description under it.</p>
            <form id="work-page-form">
              <label>Work Heading <input name="workHeading" required /></label>
              <label>Work Description
                <textarea name="workDescription" rows="8"></textarea>
              </label>
              <button type="submit" class="btn btn-solid">Save Work Page</button>
              <p class="status" id="work-page-status"></p>
            </form>

            <h3>Work items</h3>
            <div class="work-list-controls">
              <input id="work-search" type="search" placeholder="Search by title…" />
              <button type="button" id="work-add-btn" class="btn btn-solid">+ Add Work Item</button>
            </div>
            <label class="work-order-scope">Order for
              <select id="work-order-scope">
                <option value="">Work page (all videos)</option>
                {CATEGORIES.map((c) => <option value={c.tag}>{c.label} page</option>)}
              </select>
            </label>
            <p class="section-hint">
              Each category page has its own order. Pick one to see just its videos and drag them into place; it
              doesn't change the Work page. Videos not placed yet sit at the end, in the Work page order.
            </p>

            <div id="work-bulk-bar" class="work-bulk-bar" hidden>
              <div class="wb-head">
                <span id="work-bulk-count" class="work-bulk-count"></span>
                <button type="button" id="work-bulk-clear-btn" class="btn btn-ghost">Clear selection</button>
              </div>
              <label class="wb-add-label">Add tag
                <select id="work-bulk-add-select">
                  <option value="">Select…</option>
                </select>
              </label>
              <input id="work-bulk-add-new" class="wb-add-input" placeholder="or type a new tag" />
              <button type="button" id="work-bulk-add-btn" class="btn btn-ghost wb-add-btn">Add to selected</button>
              <label class="wb-remove-label">Remove tag
                <select id="work-bulk-remove-select">
                  <option value="">Select…</option>
                </select>
              </label>
              <button type="button" id="work-bulk-remove-btn" class="btn btn-ghost wb-remove-btn">Remove from selected</button>
              <p class="status wb-status" id="work-bulk-status"></p>
            </div>

            <div id="work-order-bar" class="work-order-bar" hidden>
              <span>Order changed, not saved yet.</span>
              <button type="button" id="work-order-save" class="btn btn-solid">Save Order</button>
              <button type="button" id="work-order-discard" class="btn btn-ghost">Discard</button>
              <p class="status" id="work-order-status"></p>
            </div>

            <div id="work-list" class="work-list">
              <p class="section-hint">Loading…</p>
            </div>

            <fieldset>
              <legend>Repair</legend>
              <p class="section-hint">
                The Work list, picker, and tag manager read from a lightweight index kept in sync automatically on every
                save. If it ever looks out of date (e.g. after a save reports an index warning), rebuild it here.
              </p>
              <button type="button" id="reindex-btn" class="btn btn-ghost">Rebuild Index</button>
              <p class="status" id="reindex-status"></p>
            </fieldset>
          </div>

          <div id="work-item-view" hidden>
            <button type="button" id="work-back-btn" class="btn btn-ghost">← Back to Work list</button>
            <form id="work-item-form">
              <input type="hidden" name="originalSlug" />
              <input type="hidden" name="order" value="0" />
              <input type="hidden" name="categoryOrder" value="{}" />
              <label>Page Title (optional — SEO)
                <input name="pageTitle" placeholder='e.g. Beck × Gustaf "Close" | Filmmaker Danny Dwyer' />
              </label>
              <p class="section-hint">
                Sets the browser tab title, Google search snippet, and link-preview title exactly as typed — nothing is
                appended. Leave blank to use "Header · Danny Dwyer" automatically.
              </p>

              <fieldset>
                <legend>Video link</legend>
                <div class="row">
                  <label>Platform
                    <select name="platform">
                      <option value="youtube">YouTube</option>
                      <option value="vimeo">Vimeo</option>
                    </select>
                  </label>
                  <label>Video ID
                    <input name="videoId" required placeholder="YouTube: dQw4w9WgXcQ · Vimeo: 76979871" />
                  </label>
                </div>
                <label>Thumbnail URL (optional; YouTube and Vimeo thumbnails are picked up automatically)
                  <input name="thumbnailUrl" placeholder="https://…" />
                </label>

                <div class="thumb-upload">
                  <span class="thumb-upload-label">Custom Thumbnail</span>
                  <p class="section-hint">Upload your own image (JPG, PNG or WebP) to use instead of the Vimeo/YouTube thumbnail everywhere. If it ever fails to load for a visitor, the Vimeo/YouTube thumbnail shows instead. Resized to 1280px wide automatically. Click Save Work Item to apply it.</p>
                  <input type="hidden" name="customThumbnail" />
                  <img id="thumb-preview" class="thumb-preview" alt="Custom thumbnail preview" hidden />
                  <div class="thumb-upload-actions">
                    <button type="button" id="thumb-upload-btn" class="btn btn-ghost">Upload Thumbnail</button>
                    <button type="button" id="thumb-remove-btn" class="btn btn-ghost" hidden>Remove</button>
                    <input type="file" id="thumb-file" accept="image/jpeg,image/png,image/webp" hidden />
                  </div>
                  <p class="status" id="thumb-status"></p>
                </div>
              </fieldset>

              <fieldset>
                <legend>Series</legend>
                <p class="section-hint">Turn this into a series: add more videos and they appear under the main one on this item's page, in this order. The gallery still shows a single card. Paste each video's Vimeo or YouTube link (or just its number), and optionally upload a thumbnail for it; without one, the Vimeo/YouTube thumbnail is used.</p>
                <div id="series-list" class="credits-list"></div>
                <button type="button" id="series-add-btn" class="btn btn-ghost">+ Add Video to Series</button>
              </fieldset>

              <label>Header <input name="title" required /></label>
              <p class="section-hint">The on-page heading above the description. Separate from the SEO Page Title above.</p>

              <label>Card Line (optional)
                <input name="cardLine" maxlength="160" placeholder="e.g. Three videos, one hour, one custom Versace dress." />
              </label>
              <p class="section-hint">One short line shown under the title on the home page's Featured Work cards. Leave blank to show the SEO Short Summary there instead.</p>

              <label>SEO Short Summary (150–160 characters, used for Google & link previews)
                <textarea name="summary" maxlength="200" rows="2" required></textarea>
              </label>

              <label>Description (shown on the item's page)
                <textarea name="description" rows="5"></textarea>
              </label>

              <div class="row">
                <label>Client <input name="client" /></label>
                <label>Project Name <input name="projectName" /></label>
              </div>

              <fieldset>
                <legend>Credits</legend>
                <p class="section-hint">Who worked on this, and in what role — add as many or as few as apply.</p>
                <div id="credits-list" class="credits-list"></div>
                <button type="button" id="credit-add-btn" class="btn btn-ghost">+ Add Credit</button>
              </fieldset>

              <fieldset>
                <legend>Equipment</legend>
                <p class="section-hint">Gear used on the shoot, by category — add as many or as few as apply.</p>
                <div id="equipment-list" class="credits-list"></div>
                <button type="button" id="equipment-add-btn" class="btn btn-ghost">+ Add Equipment</button>
              </fieldset>

              <!-- Not shown or edited: kept for Google's video listing and as the
                   Work grid's sort tiebreaker. New items get today's date. -->
              <input type="hidden" name="uploadDate" />
              <label>URL slug (leave blank to auto-generate from title)
                <input name="slug" placeholder="midnight-harbor" />
              </label>

              <fieldset>
                <legend>Tags</legend>
                <div id="work-tag-pills" class="tag-pills"></div>
                <div class="row">
                  <label>Add existing tag
                    <select id="work-tag-select">
                      <option value="">Select a tag…</option>
                    </select>
                  </label>
                  <label>Add new tag <input id="work-new-tag" placeholder="Type a tag and press Enter" /></label>
                </div>
              </fieldset>

              <label>Still images — one per line, as: image URL | alt text | caption (caption optional)
                <textarea name="stills" rows="3" placeholder="/images/videos/midnight-harbor/01.jpg | Dock lamps lighting the wide shot | Night one, camera A"></textarea>
              </label>

              <label class="checkbox"><input type="checkbox" name="hidden" /> Unlisted — private link only. Kept off the Work page, Google and AI search; anyone you send the link to can still watch it.</label>
              <div id="client-link-row" class="client-link-row" hidden>
                <code id="client-link-url"></code>
                <button type="button" id="client-link-copy" class="btn btn-ghost">Copy Client Link</button>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-solid">Save Work Item</button>
                <button type="button" id="work-delete-btn" class="btn btn-danger" hidden>Delete Item</button>
              </div>
              <p class="status" id="work-item-status"></p>
            </form>
          </div>
        </section>

        <!-- ============ CONTACT ============ -->
        <section id="page-contact" class="page-panel" data-page="contact" hidden>
          <h2>Contact page</h2>
          <p class="section-hint">Mirrors the contact page: the heading, then the description under it.</p>
          <form id="contact-form">
            <label>Contact Heading <input name="contactHeading" required /></label>
            <label>Contact Description
              <textarea name="contactDescription" rows="8"></textarea>
            </label>
            <button type="submit" class="btn btn-solid">Save Contact Page</button>
            <p class="status" id="contact-status"></p>
          </form>
        </section>

        <!-- ============ TAGS ============ -->
        <section id="page-tags" class="page-panel" data-page="tags" hidden>
          <h2>Tags</h2>
          <p class="section-hint">Rename or delete a tag everywhere it's used across the Work catalog.</p>
          <div id="tag-manager-list" class="tag-manager-list"></div>
          <p class="status" id="tag-manager-status"></p>
        </section>

        <!-- ============ SEO ============ -->
        <section id="page-seo" class="page-panel" data-page="seo" hidden>
          <h2>SEO &amp; GEO metadata</h2>
          <p class="section-hint">
            Overrides for each page's browser-tab title, meta/AI description, and social share image. Titles are used
            exactly as typed (nothing is appended). Leave a field blank to keep the page's own built-in default (shown
            as its placeholder). The AI-crawler file at
            <code>/llms.txt</code> and each video's own SEO fields are managed elsewhere (Home bio, Work items).
          </p>
          <div id="seo-pages"></div>
          <div class="form-actions">
            <button type="button" id="seo-save-btn" class="btn btn-solid">Save SEO</button>
          </div>
          <p class="status" id="seo-status"></p>
        </section>

        <!-- ============ SETTINGS ============ -->
        <section id="page-settings" class="page-panel" data-page="settings" hidden>
          <h2>Site settings</h2>
          <p class="section-hint">Sitewide info that isn't specific to one page — shows up in the header, footer, and contact links.</p>
          <form id="settings-form">
            <label>Name <input name="name" /></label>
            <label>Role / Title <input name="role" /></label>
            <label>Tagline <input name="tagline" /></label>
            <label>Email <input name="email" type="email" /></label>
            <label>Location <input name="location" /></label>
            <label>Instagram URL <input name="instagram" /></label>
            <label>LinkedIn URL <input name="linkedin" /></label>
            <label>IMDb URL <input name="imdb" /></label>
            <label>Vimeo URL (not shown in the footer; still listed for search engines) <input name="vimeo" /></label>
            <label>YouTube URL <input name="youtube" /></label>
            <button type="submit" class="btn btn-solid">Save Settings</button>
            <p class="status" id="settings-status"></p>
          </form>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  // ---------------------------------------------------------------------
  // Shared state — loaded once, mutated in place, and re-POSTed whole on
  // every save so one panel's save can never clobber another panel's
  // unsaved-in-this-load fields.
  // ---------------------------------------------------------------------
  type Settings = {
    name: string;
    role: string;
    tagline: string;
    introCopy: string;
    email: string;
    location: string;
    socials: Record<string, string>;
    heroSlug: string | null;
    featuredSlugs: string[];
  };

  type WorkItem = {
    slug: string;
    title: string;
    tags: string[];
    uploadDate: string;
    hidden: boolean;
    order: number;
    categoryOrder?: Record<string, number>;
  };

  let settings: Settings | null = null;
  let workItems: WorkItem[] = [];
  let workItemsLoaded = false;

  function slugify(input: string): string {
    return input
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }

  function allTags(): string[] {
    return [...new Set(workItems.flatMap((v) => v.tags))].sort();
  }

  async function loadSettings(): Promise<Settings> {
    if (settings) return settings;
    const res = await fetch('/api/settings');
    const data = await res.json();
    if (!res.ok || !data.settings) {
      throw new Error(data.error || 'The site\'s settings file could not be read from GitHub. Check the Worker\'s GITHUB_TOKEN/GITHUB_REPO/GITHUB_BRANCH secrets.');
    }
    settings = data.settings as Settings;
    return settings;
  }

  async function saveSettings(status: HTMLElement, formId: string) {
    status.textContent = 'Saving…';
    const res = await fetch('/api/settings', { method: 'POST', body: JSON.stringify({ settings }) });
    status.textContent = res.ok ? 'Saved.' : 'Error saving.';
    if (res.ok) clearDirty(formId);
  }

  async function loadWorkItems(force = false): Promise<WorkItem[]> {
    if (workItemsLoaded && !force) return workItems;
    const res = await fetch('/api/videos?full=1');
    const data = await res.json();
    if (!res.ok) {
      throw new Error(data.error || 'The Work catalog could not be read from GitHub. Check the Worker\'s GITHUB_TOKEN/GITHUB_REPO/GITHUB_BRANCH secrets.');
    }
    workItems = (data.items ?? []).sort((a: WorkItem, b: WorkItem) => a.title.localeCompare(b.title));
    workItemsLoaded = true;
    return workItems;
  }

  // ---------------------------------------------------------------------
  // Unsaved-changes tracking — a form is "dirty" once the user edits it by
  // hand (programmatic population via .value/.checked doesn't fire these
  // events, so loading data never marks a form dirty). Cleared on a
  // successful save or a confirmed discard.
  // ---------------------------------------------------------------------
  const dirtyFormIds = ['home-form', 'work-page-form', 'work-order-bar', 'work-item-form', 'contact-form', 'settings-form', 'seo-pages'];
  dirtyFormIds.forEach((id) => {
    const form = document.getElementById(id);
    form?.addEventListener('input', () => (form.dataset.dirty = '1'));
    form?.addEventListener('change', () => (form.dataset.dirty = '1'));
  });

  function isDirty(id: string | null): boolean {
    return !!id && document.getElementById(id)?.dataset.dirty === '1';
  }

  function clearDirty(id: string) {
    const form = document.getElementById(id);
    if (form) form.dataset.dirty = '';
  }

  function markDirty(id: string) {
    const form = document.getElementById(id);
    if (form) form.dataset.dirty = '1';
  }

  function confirmDiscardIfDirty(id: string | null): boolean {
    if (!isDirty(id)) return true;
    return confirm('You have unsaved changes. Discard them?');
  }

  window.addEventListener('beforeunload', (e) => {
    if (dirtyFormIds.some((id) => isDirty(id))) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  // ---------------------------------------------------------------------
  // Nav
  // ---------------------------------------------------------------------
  const navLinks = document.querySelectorAll('.nav-link');
  const pagePanels = document.querySelectorAll('.page-panel');

  function currentFormId(): string | null {
    const activePage = document.querySelector('.nav-link.active')?.getAttribute('data-page');
    if (activePage === 'home') return 'home-form';
    if (activePage === 'contact') return 'contact-form';
    if (activePage === 'settings') return 'settings-form';
    if (activePage === 'seo') return 'seo-pages';
    if (activePage === 'work') {
      const itemView = document.getElementById('work-item-view') as HTMLElement | null;
      return itemView && !itemView.hidden ? 'work-item-form' : 'work-page-form';
    }
    return null;
  }

  async function showPage(page: string) {
    navLinks.forEach((l) => l.classList.toggle('active', (l as HTMLElement).dataset.page === page));
    pagePanels.forEach((p) => {
      (p as HTMLElement).hidden = (p as HTMLElement).dataset.page !== page;
    });
    if (page === 'home') await initHomePanel();
    if (page === 'work') await initWorkPanel();
    if (page === 'contact') await initContactPanel();
    if (page === 'tags') await initTagsPanel();
    if (page === 'seo') await initSeoPanel();
    if (page === 'settings') await initSettingsPanel();
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const targetPage = (link as HTMLElement).dataset.page!;
      if (targetPage === document.querySelector('.nav-link.active')?.getAttribute('data-page')) return;
      if (!confirmDiscardIfDirty(currentFormId())) return;
      showPage(targetPage);
    });
  });

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST' });
    location.href = '/admin/login';
  });

  // ---------------------------------------------------------------------
  // Home panel
  // ---------------------------------------------------------------------
  const introEditor = document.getElementById('intro-editor') as HTMLElement;
  const introHtmlField = document.getElementById('intro-html') as HTMLTextAreaElement;

  document.querySelectorAll('.richtext-toolbar button').forEach((btn) => {
    btn.addEventListener('click', () => {
      introEditor.focus();
      const cmd = (btn as HTMLElement).dataset.cmd!;
      if (cmd === 'createLink') {
        const url = prompt('Link URL:');
        if (url) document.execCommand('createLink', false, url);
      } else if (cmd === 'formatBlock') {
        document.execCommand('formatBlock', false, (btn as HTMLElement).dataset.value!);
      } else {
        document.execCommand(cmd);
      }
      introHtmlField.value = introEditor.innerHTML;
    });
  });

  introEditor.addEventListener('input', () => {
    introHtmlField.value = introEditor.innerHTML;
  });

  // Paste as plain text. Copying from Notes, Pages, Word or a web page
  // otherwise carries that app's fonts, sizes and colors along as inline
  // styles, which override the site's own typography on the live page.
  introEditor.addEventListener('paste', (e) => {
    e.preventDefault();
    const text = e.clipboardData?.getData('text/plain') ?? '';
    document.execCommand('insertText', false, text);
    introHtmlField.value = introEditor.innerHTML;
  });

  // Featured Work dual-list state — kept separate from the form itself since
  // it isn't backed by standard form controls (drag-and-drop reordering,
  // click-to-select rows). featuredOrder is the authoritative, ordered list
  // written back to site.featuredSlugs on save.
  let featuredOrder: string[] = [];
  let featuredItemsBySlug = new Map<string, WorkItem>();
  let featuredAvailableSel: string | null = null;
  let featuredSelectedSel: string | null = null;
  let featuredDragSlug: string | null = null;

  function renderFeaturedLists() {
    const availableBox = document.getElementById('featured-available') as HTMLElement;
    const selectedBox = document.getElementById('featured-selected') as HTMLElement;

    const available = [...featuredItemsBySlug.values()]
      .filter((it) => !featuredOrder.includes(it.slug))
      .sort((a, b) => a.title.localeCompare(b.title));

    availableBox.innerHTML = available.length
      ? available
          .map(
            (it) =>
              `<div class="dual-list-row${it.slug === featuredAvailableSel ? ' active' : ''}" data-slug="${it.slug}">${escapeHtml(it.title)}</div>`
          )
          .join('')
      : '<p class="section-hint">All items selected.</p>';

    selectedBox.innerHTML = featuredOrder.length
      ? featuredOrder
          .map((slug) => {
            const title = featuredItemsBySlug.get(slug)?.title ?? slug;
            return `<div class="dual-list-row${slug === featuredSelectedSel ? ' active' : ''}" data-slug="${slug}" draggable="true">${escapeHtml(title)}</div>`;
          })
          .join('')
      : '<p class="section-hint">No items selected.</p>';

    availableBox.querySelectorAll('.dual-list-row').forEach((row) => {
      row.addEventListener('click', () => {
        featuredAvailableSel = (row as HTMLElement).dataset.slug!;
        renderFeaturedLists();
      });
      row.addEventListener('dblclick', () => addToFeatured((row as HTMLElement).dataset.slug!));
    });

    selectedBox.querySelectorAll('.dual-list-row').forEach((row) => {
      row.addEventListener('click', () => {
        featuredSelectedSel = (row as HTMLElement).dataset.slug!;
        renderFeaturedLists();
      });
      row.addEventListener('dblclick', () => removeFromFeatured((row as HTMLElement).dataset.slug!));
      row.addEventListener('dragstart', () => {
        featuredDragSlug = (row as HTMLElement).dataset.slug!;
      });
      row.addEventListener('dragover', (e) => e.preventDefault());
      row.addEventListener('drop', (e) => {
        e.preventDefault();
        const targetSlug = (row as HTMLElement).dataset.slug!;
        if (!featuredDragSlug || featuredDragSlug === targetSlug) return;
        const from = featuredOrder.indexOf(featuredDragSlug);
        const to = featuredOrder.indexOf(targetSlug);
        if (from === -1 || to === -1) return;
        featuredOrder.splice(from, 1);
        featuredOrder.splice(to, 0, featuredDragSlug);
        featuredDragSlug = null;
        markDirty('home-form');
        renderFeaturedLists();
      });
    });
  }

  function addToFeatured(slug: string) {
    if (!slug || featuredOrder.includes(slug)) return;
    featuredOrder.push(slug);
    featuredAvailableSel = null;
    markDirty('home-form');
    renderFeaturedLists();
  }

  function removeFromFeatured(slug: string) {
    featuredOrder = featuredOrder.filter((s) => s !== slug);
    featuredSelectedSel = null;
    markDirty('home-form');
    renderFeaturedLists();
  }

  document.getElementById('featured-add-btn')?.addEventListener('click', () => {
    if (featuredAvailableSel) addToFeatured(featuredAvailableSel);
  });
  document.getElementById('featured-remove-btn')?.addEventListener('click', () => {
    if (featuredSelectedSel) removeFromFeatured(featuredSelectedSel);
  });

  let homeInitialized = false;
  async function initHomePanel() {
    const homeStatus = document.getElementById('home-status')!;
    let s: Settings;
    let items: WorkItem[];
    try {
      s = await loadSettings();
      items = await loadWorkItems();
    } catch (err) {
      homeStatus.textContent = (err as Error).message;
      return;
    }
    homeStatus.textContent = '';

    const form = document.getElementById('home-form') as HTMLFormElement;
    const heroSelect = document.getElementById('hero-select') as HTMLSelectElement;
    heroSelect.innerHTML =
      '<option value="">— None —</option>' +
      items.map((item) => `<option value="${item.slug}">${item.title}${item.hidden ? ' (hidden)' : ''}</option>`).join('');
    heroSelect.value = s.heroSlug ?? '';
    (form.elements.namedItem('pageHeading') as HTMLInputElement).value = s.role ?? '';
    introEditor.innerHTML = s.introCopy ?? '';
    introHtmlField.value = s.introCopy ?? '';

    featuredItemsBySlug = new Map(items.map((item) => [item.slug, item]));
    featuredOrder = s.featuredSlugs.filter((slug) => featuredItemsBySlug.has(slug));
    featuredAvailableSel = null;
    featuredSelectedSel = null;
    renderFeaturedLists();

    if (homeInitialized) return;
    homeInitialized = true;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = document.getElementById('home-status')!;
      const fd = new FormData(form);
      const cur = await loadSettings();
      cur.heroSlug = String(fd.get('heroSlug') || '') || null;
      cur.role = String(fd.get('pageHeading') || '');
      cur.introCopy = introHtmlField.value;
      cur.featuredSlugs = [...featuredOrder];
      await saveSettings(status, 'home-form');
    });
  }

  // ---------------------------------------------------------------------
  // Work panel
  // ---------------------------------------------------------------------
  const workListView = document.getElementById('work-list-view') as HTMLElement;
  const workItemView = document.getElementById('work-item-view') as HTMLElement;
  const workListEl = document.getElementById('work-list') as HTMLElement;
  const workSearch = document.getElementById('work-search') as HTMLInputElement;
  const tagManagerList = document.getElementById('tag-manager-list') as HTMLElement;
  const workItemForm = document.getElementById('work-item-form') as HTMLFormElement;
  const workTagPills = document.getElementById('work-tag-pills') as HTMLElement;
  const workTagSelect = document.getElementById('work-tag-select') as HTMLSelectElement;
  const workNewTagInput = document.getElementById('work-new-tag') as HTMLInputElement;
  const workDeleteBtn = document.getElementById('work-delete-btn') as HTMLButtonElement;

  let workInitialized = false;
  let editingSlug: string | null = null;
  let pendingTags = new Set<string>();
  let pendingCredits: { role: string; name: string }[] = [];
  // status is a transient upload message for the row; it's never saved.
  let pendingSeries: { title: string; link: string; thumbnail?: string; status?: string }[] = [];
  let pendingEquipment: { category: string; item: string }[] = [];
  let selectedSlugs = new Set<string>();

  type SortKey = 'order' | 'title' | 'hidden';
  // Defaults to the site's actual display order (see byDisplayOrder in
  // src/lib/video.ts) — reorder controls only make sense, and only show up,
  // when sorted this way.
  // An unsaved Work order (slugs, first to last) from dragging rows or the
  // arrows; null when the list matches what's saved. Save Order commits it.
  let pendingOrder: string[] | null = null;
  // Which order the list shows and saves: '' for the Work page, or a
  // category's tag for that category page's own order.
  let orderScope = '';
  let sortKey: SortKey = 'order';
  let sortAsc = true;

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  const SORT_COLUMNS: { key: SortKey; label: string }[] = [
    { key: 'order', label: 'Order' },
    { key: 'title', label: 'Title' },
    { key: 'hidden', label: 'Status' },
  ];

  // Arrows and drag-and-drop both rearrange the list locally (nothing is
  // saved yet); Save Order then commits the whole new order at once.
  function moveWorkItemTo(sortedSlugsInView: string[], from: number, to: number) {
    if (from === to || from < 0 || to < 0 || from >= sortedSlugsInView.length || to >= sortedSlugsInView.length) return;
    const next = [...sortedSlugsInView];
    const [moved] = next.splice(from, 1);
    next.splice(to, 0, moved);
    pendingOrder = next;
    markDirty('work-order-bar');
    renderWorkList();
  }

  function moveWorkItem(sortedSlugsInView: string[], slug: string, direction: -1 | 1) {
    const i = sortedSlugsInView.indexOf(slug);
    moveWorkItemTo(sortedSlugsInView, i, i + direction);
  }

  const workOrderBar = document.getElementById('work-order-bar') as HTMLElement;
  const workOrderStatus = document.getElementById('work-order-status')!;

  function inOrderScope(item: WorkItem): boolean {
    return !orderScope || item.tags.some((t) => t.toLowerCase() === orderScope);
  }

  // An item's saved position in the current order. In a category, one not
  // placed yet counts as last (then the Work order breaks the tie).
  function scopeRank(item: WorkItem): number {
    return orderScope ? (item.categoryOrder?.[orderScope] ?? Infinity) : item.order;
  }

  const orderScopeSelect = document.getElementById('work-order-scope') as HTMLSelectElement;
  orderScopeSelect.addEventListener('change', () => {
    if (pendingOrder && !confirm('Discard the unsaved order changes?')) {
      orderScopeSelect.value = orderScope;
      return;
    }
    orderScope = orderScopeSelect.value;
    pendingOrder = null;
    clearDirty('work-order-bar');
    workOrderStatus.textContent = '';
    sortKey = 'order';
    sortAsc = true;
    renderWorkList();
  });

  // Saved orders are renumbered 10, 20, 30, ... in list order, and only the
  // items whose number actually changes are sent (so videos that shared the
  // same number get untangled the first time, and later saves only touch
  // what moved). Everything lands in one commit.
  document.getElementById('work-order-save')!.addEventListener('click', async () => {
    if (!pendingOrder) return;
    const moves = pendingOrder
      .map((slug, i) => ({ slug, order: (i + 1) * 10 }))
      .filter((m) => {
        const item = workItems.find((it) => it.slug === m.slug);
        return !item || scopeRank(item) !== m.order;
      });
    const category = orderScope || undefined;
    if (moves.length === 0) {
      pendingOrder = null;
      clearDirty('work-order-bar');
      renderWorkList();
      return;
    }
    // Sent in batches: Cloudflare caps how many GitHub requests one save can
    // make (one per video), so a big renumber goes as a few commits of up to
    // ORDER_BATCH videos each. Each batch is all-or-nothing; if one fails,
    // the batches before it are kept and Save Order picks up the rest.
    const ORDER_BATCH = 25;
    const batches = Math.ceil(moves.length / ORDER_BATCH);
    for (let b = 0; b < batches; b++) {
      const batch = moves.slice(b * ORDER_BATCH, (b + 1) * ORDER_BATCH);
      workOrderStatus.textContent = batches > 1 ? `Saving… (${b + 1} of ${batches})` : 'Saving…';
      const res = await fetch('/api/videos/reorder', { method: 'POST', body: JSON.stringify({ category, moves: batch }) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        workOrderStatus.textContent = `Error: ${data.error ?? 'could not save the order'}${b > 0 ? ' (part of the order was saved; click Save Order again to finish)' : ''}`;
        return;
      }
      batch.forEach((m) => {
        const item = workItems.find((it) => it.slug === m.slug);
        if (!item) return;
        if (category) item.categoryOrder = { ...item.categoryOrder, [category]: m.order };
        else item.order = m.order;
      });
      if (data.indexWarning) alert(data.indexWarning);
    }
    pendingOrder = null;
    clearDirty('work-order-bar');
    renderWorkList();
    workOrderStatus.textContent = '';
  });

  document.getElementById('work-order-discard')!.addEventListener('click', () => {
    pendingOrder = null;
    clearDirty('work-order-bar');
    workOrderStatus.textContent = '';
    renderWorkList();
  });

  function populateBulkTagSelects() {
    const tags = allTags();
    const options = '<option value="">Select…</option>' + tags.map((t) => `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
    (document.getElementById('work-bulk-add-select') as HTMLSelectElement).innerHTML = options;
    (document.getElementById('work-bulk-remove-select') as HTMLSelectElement).innerHTML = options;
  }

  function renderBulkTagControls() {
    populateBulkTagSelects();
    const bar = document.getElementById('work-bulk-bar') as HTMLElement;
    if (selectedSlugs.size === 0) {
      bar.hidden = true;
      return;
    }
    bar.hidden = false;
    const countEl = document.getElementById('work-bulk-count')!;
    countEl.textContent = `${selectedSlugs.size} selected`;
  }

  async function applyBulkTags(add: string[], remove: string[]) {
    const statusEl = document.getElementById('work-bulk-status')!;
    if (selectedSlugs.size === 0) return;
    statusEl.textContent = 'Saving…';
    const res = await fetch('/api/tags/bulk', {
      method: 'POST',
      body: JSON.stringify({ slugs: [...selectedSlugs], add, remove }),
    });
    const data = await res.json();
    if (!res.ok) {
      statusEl.textContent = `Error: ${data.error ?? 'failed'}`;
      return;
    }
    const failed: string[] = data.failed ?? [];
    const parts = [failed.length ? `Updated, but failed on: ${failed.join(', ')}.` : 'Done.'];
    if (data.indexWarning) parts.push(data.indexWarning);
    statusEl.textContent = parts.join(' ');
    await loadWorkItems(true);
    renderWorkList();
    renderTagManager();
  }

  document.getElementById('work-bulk-add-btn')?.addEventListener('click', () => {
    const select = document.getElementById('work-bulk-add-select') as HTMLSelectElement;
    const newInput = document.getElementById('work-bulk-add-new') as HTMLInputElement;
    const tag = newInput.value.trim() || select.value;
    if (!tag) return;
    applyBulkTags([tag], []);
    select.value = '';
    newInput.value = '';
  });

  document.getElementById('work-bulk-remove-btn')?.addEventListener('click', () => {
    const select = document.getElementById('work-bulk-remove-select') as HTMLSelectElement;
    if (!select.value) return;
    applyBulkTags([], [select.value]);
    select.value = '';
  });

  document.getElementById('work-bulk-clear-btn')?.addEventListener('click', () => {
    selectedSlugs = new Set();
    renderWorkList();
  });

  function renderWorkList() {
    const query = workSearch.value.trim().toLowerCase();
    const scoped = workItems.filter(inOrderScope);
    const filtered = scoped.filter((i) => !query || i.title.toLowerCase().includes(query));

    if (workItems.length === 0) {
      workListEl.innerHTML = '<p class="section-hint">No items match.</p>';
      return;
    }

    const dir = sortAsc ? 1 : -1;
    const sorted = [...filtered].sort((a, b) => {
      if (sortKey === 'hidden') return (Number(a.hidden) - Number(b.hidden)) * dir;
      if (sortKey === 'order' && pendingOrder) return (pendingOrder.indexOf(a.slug) - pendingOrder.indexOf(b.slug)) * dir;
      if (sortKey === 'order') {
        const ra = scopeRank(a);
        const rb = scopeRank(b);
        if (ra !== rb) return (ra < rb ? -1 : 1) * dir;
        if (a.order !== b.order) return (a.order - b.order) * dir;
        return new Date(b.uploadDate).getTime() - new Date(a.uploadDate).getTime();
      }
      return String(a[sortKey]).localeCompare(String(b[sortKey])) * dir;
    });
    const sortedSlugs = sorted.map((i) => i.slug);
    // Reordering (swapping neighbors) only makes unambiguous sense in the
    // unfiltered, ascending, order-sorted view — any other view mixes in
    // search/sort state that would make "move up" silently reorder items
    // that aren't adjacent in the real catalog order.
    const canReorder = sortKey === 'order' && sortAsc && !query;

    const headerHtml = SORT_COLUMNS.map(({ key, label }) => {
      const active = sortKey === key;
      const arrow = active ? (sortAsc ? ' ▲' : ' ▼') : '';
      return `<th data-sort-key="${key}" class="${active ? 'sorted' : ''}">${label}${arrow}</th>`;
    }).join('');

    const rowsHtml = sorted.length
      ? sorted
          .map(
            (item, i) => `
        <tr data-slug="${item.slug}" data-index="${i}">
          <td><input type="checkbox" class="work-row-select" data-slug="${item.slug}" ${selectedSlugs.has(item.slug) ? 'checked' : ''} /></td>
          <td class="work-order-cell">
            ${
              canReorder
                ? `<span class="drag-handle" title="Drag to reorder" aria-hidden="true">⠿</span>
                   <button type="button" class="btn-move" data-move-up="${item.slug}" ${i === 0 ? 'disabled' : ''} aria-label="Move up">↑</button>
                   <button type="button" class="btn-move" data-move-down="${item.slug}" ${i === sorted.length - 1 ? 'disabled' : ''} aria-label="Move down">↓</button>`
                : '<span class="work-cell-empty">—</span>'
            }
          </td>
          <td>${escapeHtml(item.title)}</td>
          <td>${item.hidden ? '<span class="status-badge status-hidden">Unlisted</span>' : '<span class="status-badge status-visible">Visible</span>'}</td>
          <td class="work-actions-cell">
            ${item.hidden ? `<button type="button" class="btn btn-ghost" data-copy-link="${item.slug}">Copy Link</button>` : ''}
            <button type="button" class="btn btn-ghost" data-edit="${item.slug}">Edit</button>
          </td>
        </tr>`
          )
          .join('')
      : `<tr><td colspan="5" class="section-hint">No items match.</td></tr>`;

    workListEl.innerHTML = `
      <div class="work-table-scroll"><table class="work-table">
        <thead><tr><th><input type="checkbox" id="work-select-all" aria-label="Select all" /></th>${headerHtml}<th></th></tr></thead>
        <tbody>${rowsHtml}</tbody>
      </table></div>
      <p class="work-count section-hint">${sorted.length} of ${scoped.length} item${scoped.length === 1 ? '' : 's'}${sortKey === 'order' ? ' — sorted by Order; switch sort to search by Title/Status' : ''}</p>
    `;

    workListEl.querySelectorAll('th[data-sort-key]').forEach((th) => {
      th.addEventListener('click', () => {
        const key = (th as HTMLElement).dataset.sortKey as SortKey;
        if (sortKey === key) sortAsc = !sortAsc;
        else {
          sortKey = key;
          sortAsc = true;
        }
        renderWorkList();
      });
    });

    workListEl.querySelectorAll('[data-copy-link]').forEach((btn) => {
      btn.addEventListener('click', () => copyClientLink((btn as HTMLElement).dataset.copyLink!, btn as HTMLButtonElement));
    });

    workListEl.querySelectorAll('[data-edit]').forEach((btn) => {
      btn.addEventListener('click', () => openWorkItem((btn as HTMLElement).dataset.edit!));
    });

    workListEl.querySelectorAll('[data-move-up]').forEach((btn) => {
      btn.addEventListener('click', () => moveWorkItem(sortedSlugs, (btn as HTMLElement).dataset.moveUp!, -1));
    });
    workListEl.querySelectorAll('[data-move-down]').forEach((btn) => {
      btn.addEventListener('click', () => moveWorkItem(sortedSlugs, (btn as HTMLElement).dataset.moveDown!, 1));
    });

    workOrderBar.hidden = !pendingOrder;

    // Drag and drop: grab a row by its handle and drop it above or below
    // another row (a gold line shows where it will land).
    if (canReorder) {
      let dragFrom = -1;
      const rows = Array.from(workListEl.querySelectorAll('tbody tr[data-index]')) as HTMLTableRowElement[];
      const clearMarks = () => rows.forEach((r) => r.classList.remove('drop-before', 'drop-after'));
      rows.forEach((row) => {
        const handle = row.querySelector('.drag-handle') as HTMLElement | null;
        handle?.addEventListener('mousedown', () => (row.draggable = true));
        row.addEventListener('dragstart', (e) => {
          dragFrom = Number(row.dataset.index);
          row.classList.add('dragging');
          e.dataTransfer?.setData('text/plain', row.dataset.slug ?? '');
          if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
        });
        row.addEventListener('dragend', () => {
          row.draggable = false;
          row.classList.remove('dragging');
          clearMarks();
        });
        row.addEventListener('dragover', (e) => {
          if (dragFrom < 0) return;
          e.preventDefault();
          const box = row.getBoundingClientRect();
          const after = e.clientY > box.top + box.height / 2;
          clearMarks();
          row.classList.add(after ? 'drop-after' : 'drop-before');
        });
        row.addEventListener('drop', (e) => {
          if (dragFrom < 0) return;
          e.preventDefault();
          const target = Number(row.dataset.index);
          const after = row.classList.contains('drop-after');
          let to = target + (after ? 1 : 0);
          if (dragFrom < to) to -= 1;
          clearMarks();
          moveWorkItemTo(sortedSlugs, dragFrom, to);
          dragFrom = -1;
        });
      });
    }

    workListEl.querySelectorAll('.work-row-select').forEach((cb) => {
      cb.addEventListener('change', () => {
        const slug = (cb as HTMLElement).dataset.slug!;
        if ((cb as HTMLInputElement).checked) selectedSlugs.add(slug);
        else selectedSlugs.delete(slug);
        renderBulkTagControls();
      });
    });

    const selectAll = document.getElementById('work-select-all') as HTMLInputElement | null;
    if (selectAll) {
      selectAll.checked = sorted.length > 0 && sorted.every((i) => selectedSlugs.has(i.slug));
      selectAll.addEventListener('change', () => {
        if (selectAll.checked) sorted.forEach((i) => selectedSlugs.add(i.slug));
        else sorted.forEach((i) => selectedSlugs.delete(i.slug));
        renderWorkList();
        renderBulkTagControls();
      });
    }

    renderBulkTagControls();
  }

  async function reportTagResult(res: Response) {
    const statusEl = document.getElementById('tag-manager-status')!;
    if (!res.ok) {
      statusEl.textContent = 'Error updating tag.';
      return;
    }
    const data = await res.json();
    const failed: string[] = data.failed ?? [];
    const parts = [failed.length ? `Updated, but failed on: ${failed.join(', ')}. Try again for those.` : 'Done.'];
    if (data.indexWarning) parts.push(data.indexWarning);
    statusEl.textContent = parts.join(' ');
  }

  function renderTagManager() {
    const tags = allTags();
    if (tags.length === 0) {
      tagManagerList.innerHTML = '<p class="section-hint">No tags yet.</p>';
      return;
    }
    tagManagerList.innerHTML = tags
      .map(
        (tag) => `
        <span class="tag-chip">
          ${tag}
          <button type="button" data-rename="${tag}" title="Rename everywhere" aria-label="Rename ${tag}">✎</button>
          <button type="button" data-delete="${tag}" title="Delete everywhere" aria-label="Delete ${tag}">×</button>
        </span>`
      )
      .join('');

    tagManagerList.querySelectorAll('[data-rename]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const tag = (btn as HTMLElement).dataset.rename!;
        const newTag = prompt(`Rename "${tag}" to:`, tag);
        if (!newTag || newTag === tag) return;
        const res = await fetch('/api/tags', { method: 'POST', body: JSON.stringify({ action: 'rename', tag, newTag }) });
        await reportTagResult(res);
        await loadWorkItems(true);
        renderWorkList();
        renderTagManager();
      });
    });

    tagManagerList.querySelectorAll('[data-delete]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const tag = (btn as HTMLElement).dataset.delete!;
        if (!confirm(`Delete tag "${tag}" from every item that uses it?`)) return;
        const res = await fetch('/api/tags', { method: 'POST', body: JSON.stringify({ action: 'delete', tag }) });
        await reportTagResult(res);
        await loadWorkItems(true);
        renderWorkList();
        renderTagManager();
      });
    });
  }

  function renderWorkTagPicker() {
    // Selected tags render as removable pills; the dropdown offers only
    // tags not already on this item, so picking one is always "add",
    // never a redundant re-select.
    workTagPills.innerHTML = pendingTags.size
      ? [...pendingTags]
          .map(
            (tag) => `
        <span class="tag-chip">
          ${escapeHtml(tag)}
          <button type="button" data-remove-tag="${escapeHtml(tag)}" aria-label="Remove ${escapeHtml(tag)}">×</button>
        </span>`
          )
          .join('')
      : '<span class="work-cell-empty">No tags yet.</span>';

    workTagPills.querySelectorAll('[data-remove-tag]').forEach((btn) => {
      btn.addEventListener('click', () => {
        pendingTags.delete((btn as HTMLElement).dataset.removeTag!);
        renderWorkTagPicker();
      });
    });

    const available = allTags().filter((t) => !pendingTags.has(t));
    workTagSelect.innerHTML =
      '<option value="">Select a tag…</option>' + available.map((t) => `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
  }

  workTagSelect.addEventListener('change', () => {
    if (!workTagSelect.value) return;
    pendingTags.add(workTagSelect.value);
    renderWorkTagPicker();
  });

  workNewTagInput.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const value = workNewTagInput.value.trim();
    if (!value) return;
    pendingTags.add(value);
    workNewTagInput.value = '';
    renderWorkTagPicker();
  });

  // Credits and Equipment are both flexible, admin-ordered lists of
  // two-field rows (role+name, category+item) — unlike tags, order matters
  // (it's display order on the Work item page) and rows can repeat the same
  // value, so this is plain inputs with add/remove/move, not a pill picker.
  // Rows re-render only on add/remove/move; typing into a field updates the
  // backing array in place via one delegated 'input' listener per list, so
  // the field the admin is actively typing in is never itself replaced
  // mid-keystroke. One generic setup covers both lists — they're mechanically
  // identical, just different field names and labels.
  function setupRepeatableRowList<A extends string, B extends string>(opts: {
    listEl: HTMLElement;
    addBtnId: string;
    // A getter, not a direct array reference — the backing variable
    // (pendingCredits/pendingEquipment) gets reassigned to a whole new
    // array when a different item is opened, and reading it fresh each
    // call is what keeps this list pointed at whichever array is current
    // instead of a stale one captured at setup time.
    getItems: () => Record<A, string>[];
    fieldA: A;
    labelA: string;
    placeholderA: string;
    fieldB: B;
    labelB: string;
    placeholderB: string;
    emptyText: string;
    // Optional extra controls shown under each row, wired up by afterRender.
    extraRow?: (row: Record<A, string>, i: number) => string;
    afterRender?: () => void;
  }) {
    function render() {
      const items = opts.getItems();
      opts.listEl.innerHTML = items.length
        ? items
            .map(
              (row, i) => `
          <div class="credit-row" data-index="${i}">
            <label>${opts.labelA}
