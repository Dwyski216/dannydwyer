---
// Public page — this is the one part of /admin the Worker lets through
// without a session, since it's how you get a session in the first place.
// See worker/index.ts for the actual auth check.
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Login" description="Site content admin login." noindex={true}>
  <main id="main" class="login">
    <h1>Site Admin</h1>
    <form id="login-form">
      <label>Password
        <input name="password" type="password" required autofocus autocomplete="current-password" />
      </label>
      <button type="submit">Log In</button>
      <p class="status" id="login-status"></p>
    </form>
  </main>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const status = document.getElementById('login-status') as HTMLElement;

  // If you already have a valid session, bounce straight to /admin instead
  // of showing the form again.
  fetch('/api/videos', { method: 'GET' }).then((res) => {
    if (res.ok) location.href = '/admin';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Checking…';
    const fd = new FormData(form);
    const res = await fetch('/api/login', {
      method: 'POST',
      body: JSON.stringify({ password: fd.get('password') }),
    });
    if (res.ok) {
      location.href = '/admin';
      return;
    }
    const data = await res.json().catch(() => ({}));
    status.textContent = data.error || 'Login failed.';
    form.reset();
  });
</script>

<style>
  .login {
    max-width: 360px;
    margin: 0 auto;
    padding: 6rem clamp(1.25rem, 4vw, 2rem) 3rem;
  }

  h1 {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  input {
    font-family: var(--font-body);
    background: var(--surface);
    border: 1px solid var(--hairline);
    color: var(--text);
    padding: 0.6rem 0.7rem;
    font-size: 0.95rem;
  }

  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  button {
    align-self: flex-start;
    font-family: var(--font-body);
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    padding: 0.7rem 1.4rem;
    font-size: 0.9rem;
    cursor: pointer;
  }

  button:hover {
    background: var(--accent-dim);
  }

  .status {
    font-size: 0.85rem;
    color: var(--accent);
    min-height: 1.2em;
  }
</style>
