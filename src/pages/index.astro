---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { getEmbedUrl, getThumbnailUrl } from '../lib/video';
import { getEnabledSections } from '../data/layout';
import { getSeoOverride } from '../data/seo';

const sections = getEnabledSections('home');
const seo = getSeoOverride('home');

const videos = await getCollection('videos');

// The hero video is picked from the Work catalog in the admin panel (by
// slug), same as Featured Work — it can be a hidden item, like a temporary
// reel that isn't meant to show up in the Work grid itself.
const matchedReel = site.heroSlug ? videos.find((v) => v.data.urlSlug === site.heroSlug) : undefined;
const heroVideo = matchedReel ? { platform: matchedReel.data.platform, videoId: matchedReel.data.videoId } : null;

const featured = site.featuredSlugs
  .map((slug) => videos.find((v) => v.data.urlSlug === slug))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));
const featuredThumbnails = await Promise.all(featured.map((v) => getThumbnailUrl(v.data)));

const jsonLd = heroVideo
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: matchedReel?.data.title ?? site.name,
        description: matchedReel?.data.summary ?? site.tagline,
        ...(matchedReel ? { thumbnailUrl: await getThumbnailUrl(matchedReel.data) } : {}),
        ...(matchedReel?.data.uploadDate ? { uploadDate: matchedReel.data.uploadDate } : {}),
        ...(matchedReel?.data.durationISO ? { duration: matchedReel.data.durationISO } : {}),
        embedUrl: getEmbedUrl(heroVideo),
      },
    ]
  : [];
---

<Layout
  title={seo.title || 'Home'}
  description={seo.description || site.tagline}
  ogImage={seo.ogImage || undefined}
  jsonLd={jsonLd}
>
  <SiteHeader />

  <main class="main container">
    <div class="grid">
      {sections.map((section) => {
        if (section === 'hero') return <Hero heroVideo={heroVideo} title={matchedReel?.data.title ?? site.name} />;
        if (section === 'intro') return <Intro role={site.role} introCopy={site.introCopy} />;
        if (section === 'featured') return <FeaturedWork featured={featured} thumbnails={featuredThumbnails} />;
        return null;
      })}
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .main {
    padding-bottom: 2rem;
  }
</style>
