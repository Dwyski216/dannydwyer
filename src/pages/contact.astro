---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBody from '../components/sections/ContactBody.astro';
import { getEntry } from 'astro:content';
import { site } from '../data/site';
import { getEnabledSections } from '../data/layout';
import { getSeoOverride } from '../data/seo';

const sections = getEnabledSections('contact');
const seo = getSeoOverride('contact');
const page = await getEntry('pages', 'contact');
const { Content } = await page.render();
---

<Layout
  title={seo.title || 'Contact'}
  description={seo.description || page.data.summary || site.tagline}
  ogImage={seo.ogImage || undefined}
>
  <SiteHeader />
  <main class="main container">
    {sections.map((section) => {
      if (section === 'body') {
        return (
          <ContactBody title={page.data.title} email={site.email}>
            <Content />
          </ContactBody>
        );
      }
      return null;
    })}
  </main>
  <SiteFooter />
</Layout>

<style>
  .main {
    padding: 1rem clamp(1.25rem, 4vw, 2rem) 3rem;
  }
</style>
