---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactTitle from '../components/sections/ContactTitle.astro';
import ContactBody from '../components/sections/ContactBody.astro';
import { getEntry } from 'astro:content';
import { site } from '../data/site';
import { getEnabledSections } from '../data/layout';

const sections = getEnabledSections('contact');
const page = await getEntry('pages', 'contact');
const { Content } = await page.render();
---

<Layout title="Contact" description={page.data.summary ?? site.tagline}>
  <SiteHeader />
  <main class="main container">
    {sections.map((section) => {
      if (section === 'title') return <ContactTitle />;
      if (section === 'body') {
        return (
          <ContactBody email={site.email} location={site.location}>
            <Content />
          </ContactBody>
        );
      }
      return null;
    })}
  </main>
  <SiteFooter />
</Layout>

<style>
  .main {
    padding: 1rem clamp(1.25rem, 4vw, 2rem) 3rem;
  }
</style>
