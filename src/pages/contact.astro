---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getEntry } from 'astro:content';
import { site } from '../data/site';

const page = await getEntry('pages', 'contact');
const { Content } = await page.render();
---

<Layout title="Contact" description={page.data.summary ?? site.tagline}>
  <SiteHeader />
  <main class="main container">
    <div class="layout">
      <div class="photo-col">
        <div class="photo-frame">
          <img
            class="photo"
            src="/images/dwyer-on-set.webp"
            alt="Danny Dwyer, cinematographer, on set"
            width="1600"
            height="2000"
            loading="eager"
          />
        </div>
      </div>

      <div class="copy-col">
        <h1 class="page-title">Contact</h1>
        <div class="prose">
          <Content />
        </div>

        <div class="action">
          <a class="button" href={`mailto:${site.email}`}>Get in touch</a>
          <a class="email-plain" href={`mailto:${site.email}`}>{site.email}</a>
          {site.location && <span class="location">{site.location}</span>}
        </div>

        <img
          class="sign-off"
          src="/DWYER_MONOGRAM_VARIATIONS/FLAT/DD_FLAT_HEADLIGHT_RED.png"
          alt=""
          width="56"
          height="56"
        />
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .main {
    padding: 1rem clamp(1.25rem, 4vw, 2rem) 3rem;
  }

  .layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 801px) {
    .layout {
      /* photo-col is first in the DOM (so it's the element that stacks on
         top on mobile, per spec) but row-reverse puts it on the right on
         desktop without needing a second markup order. */
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .photo-col {
    flex: 0 0 auto;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
  }

  @media (min-width: 801px) {
    .photo-col {
      flex-basis: 42%;
      max-width: none;
      margin-inline: 0;
    }
  }

  /* Signature Treatment, photo variant: a solid hard-edge Headlight block
     offset down-and-right behind the photo (same family as the wordmark's
     drop shadow, just scaled to a photo instead of text) — no blur. */
  .photo-frame {
    position: relative;
  }

  .photo-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--headlight);
    transform: translate(12%, 9%);
    z-index: 0;
  }

  .photo {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .copy-col {
    flex: 1 1 auto;
    min-width: 0;
  }

  .prose {
    font-family: var(--font-body);
    color: color-mix(in srgb, var(--headlight) 88%, transparent);
    font-size: 1.1rem;
    line-height: 1.75;
    max-width: 68ch;
    margin-top: 1.5rem;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .prose :global(p) {
    margin: 0 0 1.1rem;
  }

  .prose :global(a) {
    color: var(--olympic-gold);
    text-decoration: underline;
  }

  .action {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .button {
    display: inline-block;
    background: var(--olympic-gold);
    color: var(--on-accent);
    font-family: var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1rem;
    padding: 0.9rem 1.75rem;
    transition: background 0.15s ease;
  }

  .button:hover {
    background: var(--accent-dim);
  }

  .email-plain {
    color: color-mix(in srgb, var(--headlight) 75%, transparent);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .location {
    color: color-mix(in srgb, var(--headlight) 60%, transparent);
    font-size: 0.85rem;
  }

  .sign-off {
    display: block;
    margin: 3rem auto 0;
    height: clamp(48px, 6vw, 64px);
    width: clamp(48px, 6vw, 64px);
  }
</style>
