---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getEntry } from 'astro:content';
import { site } from '../data/site';

const page = await getEntry('pages', 'contact');
const { Content } = await page.render();
---

<Layout title="Contact" description={page.data.summary ?? site.tagline}>
  <SiteHeader />
  <main class="main">
    <h1>{page.data.title}</h1>
    <div class="prose">
      <Content />
    </div>

    <div class="details">
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
      {site.location && <span class="location">{site.location}</span>}
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .main {
    max-width: 640px;
    margin: 0 auto;
    padding: 1rem clamp(1.25rem, 4vw, 2rem) 3rem;
  }

  h1 {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    margin-bottom: 1.5rem;
  }

  .prose {
    font-family: var(--font-body);
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin: 0 0 1.1rem;
  }

  .details {
    margin-top: 2rem;
    background: var(--shit-kicker);
    border: 1px solid var(--shit-kicker);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .email {
    color: var(--headlight);
    font-size: 1.1rem;
    text-decoration: underline;
  }

  .location {
    color: var(--headlight);
    opacity: 0.75;
    font-size: 0.9rem;
  }
</style>
