---
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, any>[];
  noindex?: boolean;
}

const { title, description, ogImage = '/images/og-default.jpg', jsonLd = [], noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Site-wide Person schema — this is the single highest-leverage AEO addition
// for a personal portfolio. It tells AI answer engines unambiguously who this
// site is about and what they do.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.tagline,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location,
  },
  sameAs: Object.values(site.socials).filter(Boolean),
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ${site.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Structured data: site-wide Person schema, plus any page-specific schema passed in -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The brand's actual typefaces — Futura Bold and Trade Gothic — are
         commercial and aren't available as web fonts. Each font stack below
         lists the real name first (so a visitor who has it installed
         locally, e.g. Futura ships with macOS, sees the genuine thing) and
         falls back to the closest free Google Fonts equivalent: Jost for
         Futura's geometric circles, Oswald for Trade Gothic Bold No.2's
         condensed storefront-sign feel, and Public Sans for Trade Gothic
         Regular's plain, easy-to-read body text. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@500;700&family=Oswald:wght@600;700&family=Public+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Color tokens — from the DWYER_STYLE_GUIDE brand system: "five colors,
       three do the work, two back 'em up." Ink is the dark stage everything
       sits on; Headlight is the readable voice; Barn Red is the name in
       lights (big sizes only — never small body text); Olympic Gold means
       go (links, buttons, anything interactive); Shit Kicker is the warm
       neutral reserved for one special panel at a time (featured project,
       footer band, contact block) so it doesn't turn muddy repeated
       everywhere. Night Shift is Ink "with the lights turned up a notch" —
       the everyday box/card/panel color, used instead of Shit Kicker so
       footage and Gold stay the things that pop.  */
    --ink: #081d23;
    --headlight: #fff3b0;
    --barn-red: #9e2a2b;
    --olympic-gold: #e09f3e;
    --shit-kicker: #5c3b23;
    --night-shift: #12323b;

    --bg: var(--ink);
    --surface: var(--night-shift);
    --text: var(--headlight);
    --text-muted: color-mix(in srgb, var(--headlight) 60%, var(--ink));
    --accent: var(--olympic-gold);
    --accent-dim: color-mix(in srgb, var(--olympic-gold) 72%, black);
    --on-accent: var(--ink); /* text color for content sitting on top of --accent */
    --hairline: color-mix(in srgb, var(--headlight) 16%, var(--ink));
    --tag-muted: color-mix(in srgb, var(--olympic-gold) 55%, var(--headlight));

    /* Futura Bold — the name, the logo, section headings (title case). */
    --font-display: Futura, 'Futura PT', Jost, 'Century Gothic', -apple-system, sans-serif;
    /* Trade Gothic Bold No. 2 — video titles and project names, ALL CAPS. */
    --font-title: 'Trade Gothic Bold No. 2', 'Trade Gothic Bold', Oswald, 'Arial Narrow', sans-serif;
    /* Trade Gothic Regular — descriptions, credits, captions, reading text. */
    --font-body: 'Trade Gothic', 'Trade Gothic Regular', 'Public Sans', -apple-system, sans-serif;

    --content-width: 1100px;
    --side-padding: clamp(1.25rem, 4vw, 2rem);
    --gutter: clamp(1rem, 2.5vw, 1.75rem);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    /* Safety net: a flex/grid row that forgets to wrap on narrow screens
       should never be able to push the whole page into horizontal scroll. */
    overflow-x: hidden;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--accent-dim);
    color: var(--on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Shared 12-column grid + gutter system. `.container` centers content and
     applies the side padding; `.grid` lays out a 12-column row inside it
     (or anywhere else) with a consistent gutter; `.col-*` utilities span
     that grid and collapse to full-width below 720px. */
  .container {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--side-padding);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
  }

  .col-4 { grid-column: span 4; }
  .col-6 { grid-column: span 6; }
  .col-8 { grid-column: span 8; }
  .col-12 { grid-column: span 12; }

  @media (max-width: 720px) {
    .col-4, .col-6, .col-8 {
      grid-column: span 12;
    }
  }
</style>
