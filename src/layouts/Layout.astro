---
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, any>[];
  noindex?: boolean;
  // A complete, hand-written <title>/og:title/twitter:title — used verbatim,
  // with no " · site.name" suffix appended (the caller's string already
  // contains its own framing, e.g. "... | Filmmaker Danny Dwyer"). `title`
  // is still required when this is set: it's what the rest of the page
  // (JSON-LD name, breadcrumb label, etc.) continues to use — this prop
  // only ever affects where the page announces itself outside its own body.
  titleOverride?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-default.jpg',
  jsonLd = [],
  noindex = false,
  titleOverride,
} = Astro.props;
const fullTitle = titleOverride || `${title} · ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Site-wide Person schema — this is the single highest-leverage AEO addition
// for a personal portfolio. It tells AI answer engines unambiguously who this
// site is about and what they do.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.alternateName,
  jobTitle: site.role,
  description: site.tagline,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location,
  },
  sameAs: Object.values(site.socials).filter(Boolean),
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Speeds up the video embed's connection setup on pages that use
         VideoPlayer (home hero, every work item) — negligible cost on pages
         that don't. -->
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Structured data: site-wide Person schema, plus any page-specific schema passed in -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Self-hosted brand fonts (public/FONTS/) — the real Futura Bold and
     Trade Gothic files from the design asset drop, not a free lookalike. */
  @font-face {
    font-family: 'Futura Bold';
    src: url('/FONTS/FUTURA_BOLD/Futura%20Bold.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Trade Gothic Bold No 2';
    src: url('/FONTS/TRADE_GOTHIC_NO2_BOLD/Trade%20Gothic%20LT%20Std%20Bold%20No.%202.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Trade Gothic Regular';
    src: url('/FONTS/TRADE_GOTHIC_REGULAR/TradeGothic%20Regular.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Color tokens — from the DWYER_STYLE_GUIDE brand system: "five colors,
       three do the work, two back 'em up." Ink is the dark stage everything
       sits on; Headlight is the readable voice; Barn Red is the name in
       lights (big sizes only — never small body text); Olympic Gold means
       go (links, buttons, anything interactive); Shit Kicker is the warm
       neutral reserved for one special panel at a time (featured project,
       footer band, contact block) so it doesn't turn muddy repeated
       everywhere. Night Shift is Ink "with the lights turned up a notch" —
       the everyday box/card/panel color, used instead of Shit Kicker so
       footage and Gold stay the things that pop.  */
    --ink: #081d23;
    --headlight: #fff3b0;
    --barn-red: #9e2a2b;
    --olympic-gold: #e09f3e;
    --shit-kicker: #5c3b23;
    --night-shift: #12323b;

    --bg: var(--ink);
    --surface: var(--night-shift);
    --text: var(--headlight);
    --text-muted: color-mix(in srgb, var(--headlight) 60%, var(--ink));
    --accent: var(--olympic-gold);
    --accent-dim: color-mix(in srgb, var(--olympic-gold) 72%, black);
    --on-accent: var(--ink); /* text color for content sitting on top of --accent */
    --hairline: color-mix(in srgb, var(--headlight) 16%, var(--ink));
    --tag-muted: color-mix(in srgb, var(--olympic-gold) 55%, var(--headlight));

    /* Futura Bold — the name, the logo, section headings (title case). */
    --font-display: 'Futura Bold', 'Century Gothic', -apple-system, sans-serif;
    /* Trade Gothic Bold No. 2 — video titles and project names, ALL CAPS. */
    --font-title: 'Trade Gothic Bold No 2', 'Arial Narrow', sans-serif;
    /* Trade Gothic Regular — descriptions, credits, captions, reading text. */
    --font-body: 'Trade Gothic Regular', -apple-system, sans-serif;

    --content-width: 1100px;
    --side-padding: clamp(1.25rem, 4vw, 2rem);
    --gutter: clamp(1rem, 2.5vw, 1.75rem);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    /* Safety net: a flex/grid row that forgets to wrap on narrow screens
       should never be able to push the whole page into horizontal scroll. */
    overflow-x: hidden;
    /* Pins the footer to the bottom of the viewport on short pages instead
       of leaving empty Ink below it — the footer's own margin-top: auto
       (SiteFooter.astro) absorbs whatever space main doesn't fill. */
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* header/main/footer all carry .container, whose margin-inline: auto
     disables flex's default cross-axis stretch (an auto margin on the
     cross axis always wins over align-items: stretch) — without this
     they'd shrink-wrap to their content width and center themselves
     instead of spanning the page. */
  body > * {
    width: 100%;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }

  /* The Signature Treatment, reused for every top-level page heading (Home,
     Work, Contact): Barn Red text on a hard-edge Headlight drop shadow, no
     blur, offset down-and-right at roughly 37°. Sized in em so the shadow
     stays proportional at any font-size a page sets locally. A video
     project's own title (work/[slug]) intentionally does NOT use this — it
     keeps its separate Trade Gothic Bold No. 2 identity instead. */
  .page-title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--barn-red);
    text-shadow: 0.075em 0.056em 0 var(--headlight);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--accent-dim);
    color: var(--on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Shared 12-column grid + gutter system. `.container` centers content and
     applies the side padding; `.grid` lays out a 12-column row inside it
     (or anywhere else) with a consistent gutter; `.col-*` utilities span
     that grid and collapse to full-width below 720px. */
  .container {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--side-padding);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
  }

  .col-4 { grid-column: span 4; }
  .col-6 { grid-column: span 6; }
  .col-8 { grid-column: span 8; }
  .col-12 { grid-column: span 12; }

  @media (max-width: 720px) {
    .col-4, .col-6, .col-8 {
      grid-column: span 12;
    }
  }
</style>
